---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  missionId?: string;
}

const { title, missionId } = Astro.props;
---

<BaseLayout title={title}>
  <div class="flex h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-800 border-r border-slate-700 p-4">
      <h2 class="text-lg font-semibold mb-4 text-rescue-400">Mission Control</h2>
      {missionId && (
        <div class="mb-4 text-sm">
          <span class="text-slate-400">Mission:</span>
          <span class="text-slate-200 block font-mono">{missionId}</span>
        </div>
      )}
      <nav class="space-y-2">
        <a href="#overview" class="block px-3 py-2 rounded hover:bg-slate-700 text-slate-300">Overview</a>
        <a href="#agents" class="block px-3 py-2 rounded hover:bg-slate-700 text-slate-300">Agents</a>
        <a href="#telemetry" class="block px-3 py-2 rounded hover:bg-slate-700 text-slate-300">Telemetry</a>
        <a href="#sensors" class="block px-3 py-2 rounded hover:bg-slate-700 text-slate-300">Sensors</a>
        <a href="#timeline" class="block px-3 py-2 rounded hover:bg-slate-700 text-slate-300">Timeline</a>
        <a href="#ai-analyst" class="block px-3 py-2 rounded hover:bg-slate-700 text-slate-300">AI Analyst</a>
        <a href="#report" class="block px-3 py-2 rounded hover:bg-slate-700 text-slate-300">Report</a>
      </nav>
    </aside>
    
    <!-- Main dashboard content -->
    <main class="flex-1 overflow-auto">
      <slot />
    </main>
  </div>
</BaseLayout>
