---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "RescueMesh - Simulation-first mission dashboard for dangerous environments" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | RescueMesh</title>
  </head>
  <body class="bg-slate-900 text-slate-100">
    <nav class="bg-slate-800 border-b border-slate-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="text-2xl font-bold text-rescue-400">RescueMesh</a>
            <div class="hidden md:ml-10 md:flex md:space-x-8">
              <a href="/architecture" class="text-slate-300 hover:text-rescue-400 px-3 py-2">Architecture</a>
              <a href="/use-cases" class="text-slate-300 hover:text-rescue-400 px-3 py-2">Use Cases</a>
              <a href="/hardware" class="text-slate-300 hover:text-rescue-400 px-3 py-2">Hardware</a>
              <a href="/demo" class="text-slate-300 hover:text-rescue-400 px-3 py-2">Demo</a>
            </div>
          </div>
        </div>
      </div>
    </nav>
    <main class="min-h-screen">
      <slot />
    </main>
    <footer class="bg-slate-800 border-t border-slate-700 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="text-center mb-4">
          <p class="text-slate-400 text-sm mb-3">
            RescueMesh Mission Platform - Simulation-first dashboard for GPS-denied environments
          </p>
          <div class="flex justify-center items-center gap-6 text-sm">
            <a href="https://ddeveloper72.github.io/" target="_blank" rel="noopener noreferrer" class="text-rescue-400 hover:text-rescue-300 transition-colors">
              About
            </a>
            <a href="https://www.linkedin.com/in/duncanfalconer/" target="_blank" rel="noopener noreferrer" class="text-rescue-400 hover:text-rescue-300 transition-colors">
              LinkedIn
            </a>
            <a href="https://github.com/ddeveloper72" target="_blank" rel="noopener noreferrer" class="text-rescue-400 hover:text-rescue-300 transition-colors">
              GitHub
            </a>
            <a href="https://github.com/ddeveloper72/rescuemesh-mission-platform" target="_blank" rel="noopener noreferrer" class="text-rescue-400 hover:text-rescue-300 transition-colors">
              Repository
            </a>
            <a href="/architecture" class="text-rescue-400 hover:text-rescue-300 transition-colors">
              Documentation
            </a>
          </div>
        </div>
        <p class="text-center text-slate-500 text-xs">
          MIT License © 2026 Duncan Falconer
        </p>
      </div>
    </footer>
  </body>
</html>
