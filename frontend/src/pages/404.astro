---
/**
 * RescueMesh 404 Error Page
 * 
 * Handles all unmatched routes gracefully with helpful navigation.
 * 
 * Purpose:
 * - Provide a clear, friendly error message
 * - Maintain RescueMesh branding and design consistency
 * - Offer helpful navigation links to get users back on track
 * - Explain what might have gone wrong
 * 
 * Triggered when:
 * - User navigates to a non-existent route
 * - Bookmark or link points to removed/renamed content
 * - Typo in URL path
 * 
 * Design:
 * - Uses BaseLayout for consistent navigation and footer
 * - Mission-themed messaging with drone/navigation metaphor
 * - Clear call-to-action links to main sections
 * - Responsive layout matching platform aesthetic
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404: Route Not Found" 
  description="The requested page could not be found on the RescueMesh platform"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Error Code Display -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-rescue-500/10 border-2 border-rescue-500/30 mb-6">
        <svg class="w-12 h-12 text-rescue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h1 class="text-6xl font-bold text-rescue-400 mb-2">404</h1>
      <h2 class="text-2xl font-semibold text-slate-200 mb-4">Route Not Found</h2>
    </div>

    <!-- Error Message -->
    <div class="bg-slate-800 border border-slate-700 rounded-lg p-8 mb-8">
      <div class="flex items-start gap-4 mb-6">
        <div class="flex-shrink-0">
          <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-slate-200 mb-2">Signal Lost - Navigation Error</h3>
          <p class="text-slate-400 mb-4">
            The route you're trying to reach doesn't exist in our mission map. This could happen if:
          </p>
          <ul class="list-disc list-inside text-slate-400 space-y-1 ml-2">
            <li>The URL was typed incorrectly</li>
            <li>The page has been moved or renamed</li>
            <li>The link from another site is outdated</li>
            <li>The requested resource is not yet available</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Navigation Options -->
    <div class="mb-8">
      <h3 class="text-xl font-semibold text-slate-200 mb-4 text-center">Navigate to Safety</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Home Link -->
        <a 
          href="/" 
          class="group bg-slate-800 border border-slate-700 hover:border-rescue-500 rounded-lg p-6 transition-all duration-200 hover:shadow-lg hover:shadow-rescue-500/20"
        >
          <div class="flex items-center gap-3 mb-2">
            <svg class="w-6 h-6 text-rescue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            <h4 class="text-lg font-semibold text-slate-200 group-hover:text-rescue-400 transition-colors">Home Base</h4>
          </div>
          <p class="text-slate-400 text-sm">Return to the main platform overview and mission control</p>
        </a>

        <!-- Use Cases Link -->
        <a 
          href="/use-cases" 
          class="group bg-slate-800 border border-slate-700 hover:border-rescue-500 rounded-lg p-6 transition-all duration-200 hover:shadow-lg hover:shadow-rescue-500/20"
        >
          <div class="flex items-center gap-3 mb-2">
            <svg class="w-6 h-6 text-rescue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <h4 class="text-lg font-semibold text-slate-200 group-hover:text-rescue-400 transition-colors">Mission Scenarios</h4>
          </div>
          <p class="text-slate-400 text-sm">Explore supported use cases and mission types</p>
        </a>

        <!-- Demo Link -->
        <a 
          href="/demo" 
          class="group bg-slate-800 border border-slate-700 hover:border-rescue-500 rounded-lg p-6 transition-all duration-200 hover:shadow-lg hover:shadow-rescue-500/20"
        >
          <div class="flex items-center gap-3 mb-2">
            <svg class="w-6 h-6 text-rescue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h4 class="text-lg font-semibold text-slate-200 group-hover:text-rescue-400 transition-colors">Live Demos</h4>
          </div>
          <p class="text-slate-400 text-sm">Watch interactive mission simulations in action</p>
        </a>

        <!-- Architecture Link -->
        <a 
          href="/architecture" 
          class="group bg-slate-800 border border-slate-700 hover:border-rescue-500 rounded-lg p-6 transition-all duration-200 hover:shadow-lg hover:shadow-rescue-500/20"
        >
          <div class="flex items-center gap-3 mb-2">
            <svg class="w-6 h-6 text-rescue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <h4 class="text-lg font-semibold text-slate-200 group-hover:text-rescue-400 transition-colors">Platform Architecture</h4>
          </div>
          <p class="text-slate-400 text-sm">Learn about the technical foundation and design decisions</p>
        </a>
      </div>
    </div>

    <!-- Additional Help -->
    <div class="bg-slate-800/50 border border-slate-700/50 rounded-lg p-6 text-center">
      <p class="text-slate-400 text-sm mb-2">
        Still need help finding what you're looking for?
      </p>
      <p class="text-slate-400 text-sm">
        Check the navigation menu above or
        <a href="/" class="text-rescue-400 hover:text-rescue-300 font-medium transition-colors">return to home</a>
        to start fresh.
      </p>
    </div>

    <!-- Developer Info (subtle) -->
    <div class="mt-8 text-center">
      <p class="text-slate-500 text-xs">
        Error Code: 404 | Resource Not Found | RescueMesh Platform
      </p>
    </div>
  </div>
</BaseLayout>
