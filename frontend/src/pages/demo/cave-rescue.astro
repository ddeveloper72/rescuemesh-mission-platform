---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoDashboard from '../../components/demo/DemoDashboard.astro';
import { API_ENDPOINTS, fetchWithFallbackSource } from '../../lib/api';
import type { UseCaseDemoProfile } from '../../types/demo';
import { getDemoProfileFallback } from '../../data/demo-profile-fallbacks';

const fallback = getDemoProfileFallback('cave-rescue');
if (!fallback) {
  return Astro.redirect('/404');
}

const { data: profile, source } = await fetchWithFallbackSource<UseCaseDemoProfile>(
  API_ENDPOINTS.useCases.demoProfile('cave-rescue'),
  fallback
);
---

<BaseLayout title={`${profile.title} - Demo`} description={profile.missionObjective}>
  <DemoDashboard profile={profile} source={source} />
</BaseLayout>
