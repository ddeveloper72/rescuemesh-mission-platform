---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SimulationControls from '../../../components/demo/SimulationControls.astro';
import TacticalMap from '../../../components/demo/TacticalMap.astro';
import DataSourceBadge from '../../../components/demo/DataSourceBadge.astro';
import MediaFeedsPanel from '../../../components/islands/MediaFeedsPanel';
import AudioDetectionsPanel from '../../../components/islands/AudioDetectionsPanel';
import DetectionDetailModal from '../../../components/islands/DetectionDetailModal';
import AgentDetailModal from '../../../components/demo/AgentDetailModal.astro';
import RouteProfile from '../../../components/demo/RouteProfile.astro';
import DistanceLinkBudgetPanel from '../../../components/islands/DistanceLinkBudgetPanel';
import LightingControlPanel from '../../../components/islands/LightingControlPanel';
import HydrophonePanel from '../../../components/islands/HydrophonePanel';
import TalkbackPanel from '../../../components/islands/TalkbackPanel';

const MISSION_PK = '2c6ccd68-85f6-49ac-b28d-6f5358bc6a68';
const USE_CASE = 'flooded-structure';
const TITLE = 'Flooded Structure';

const initialClock = {
  started_at: null,
  elapsed_seconds: 0,
  speed_multiplier: 1.0,
  is_running: false,
};
---

<BaseLayout 
  title={`Live Simulation - ${TITLE}`}
  description="Real-time flooded structure inspection simulation with Django API"
>
  <div class="min-h-screen bg-slate-900 text-slate-100 py-8 px-4 sm:px-6 lg:px-8" data-mission-pk={MISSION_PK}>
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <a href="/demo" class="text-rescue-400 hover:text-rescue-300 text-sm mb-4 inline-block">
          ← Back to Demo Overview
        </a>
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div>
            <h1 class="text-4xl font-bold mb-2">Live Simulation: {TITLE}</h1>
            <p class="text-slate-400">Amphibious inspection and hazard assessment</p>
            <a href="/demo/flooded-structure" class="text-xs text-slate-500 hover:text-slate-400 mt-1 inline-block">
              View static profile →
            </a>
          </div>
          <DataSourceBadge source="django" />
        </div>
      </div>

      <!-- Use Case Navigation -->
      <div class="mb-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-sm font-semibold mb-2">Switch Use Case:</div>
        <div class="flex flex-wrap gap-2">
          <a href="/demo/live/collapsed-building-search" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400">
            Collapsed Building
          </a>
          <a href="/demo/live/cave-rescue" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400">
            Cave Rescue
          </a>
          <a href="/demo/live/flooded-structure" class="px-4 py-2 bg-rescue-600 rounded text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-300">
            Flooded Structure
          </a>
          <a href="/demo/live/industrial-inspection" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400">
            Industrial Inspection
          </a>
        </div>
      </div>

      <!-- Simulation Controls -->
      <div class="mb-8">
        <SimulationControls clock={initialClock} missionPk={MISSION_PK} />
      </div>

      <!-- Tactical Map -->
      <div id="tactical-map-container" class="mb-8">
        <TacticalMap useCase={USE_CASE} />
      </div>

      <!-- Route Profile -->
      <div id="route-profile-container" class="mb-8">
        <RouteProfile containerId="route-profile" title="Route Profile — Depth View" />
      </div>

      <!-- Dashboard Grid -->
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Agent Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Agent Status</h2>
          <div id="agents-container" class="space-y-4">
            <p class="text-slate-400">Loading agents...</p>
          </div>
        </div>

        <!-- Network Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Network Status</h2>
          
          <!-- Network Health Indicator -->
          <div class="mb-4 p-3 rounded-lg" id="network-health-indicator">
            <div class="flex items-center gap-2">
              <span class="text-2xl" id="network-health-icon">🟢</span>
              <span class="font-semibold" id="network-health-label">Healthy</span>
            </div>
          </div>

          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Mesh Health:</span>
              <span id="mesh-health" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Packet Loss:</span>
              <span id="packet-loss" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Base Signal:</span>
              <span id="base-signal" class="font-semibold">--</span>
            </div>
          </div>

          <!-- Active Relay Chain -->
          <div class="mt-4 pt-4 border-t border-slate-700">
            <h3 class="text-sm font-semibold text-slate-400 mb-2">Active Relay Chain</h3>
            <div id="relay-chain" class="space-y-1 text-sm">
              <p class="text-slate-500">No relays active</p>
            </div>
          </div>
        </div>

        <!-- Water Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Water Status</h2>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Current Depth:</span>
              <span id="water-depth" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Contamination Level:</span>
              <span id="contamination" class="font-semibold">--</span>
            </div>
          </div>
        </div>

        <!-- Sensor Data Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Environmental Sensors</h2>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Thermal Anomalies:</span>
              <span id="thermal-count" class="font-semibold">0</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Hazards Detected:</span>
              <span id="hazard-count" class="font-semibold">0</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Media Feeds Panel -->
      <div class="mt-6">
        <MediaFeedsPanel mediaFeeds={[]} client:load />
      </div>

      <!-- Audio Detections Panel -->
      <div class="mt-6">
        <AudioDetectionsPanel missionId={MISSION_PK} client:load />
      </div>

      <!-- Distance & Link Budget Panel -->
      <div class="mt-6">
        <DistanceLinkBudgetPanel client:load />
      </div>

      <!-- Capability Packs Section -->
      <div class="mt-6">
        <h2 class="text-2xl font-bold mb-4">Capability Packs</h2>
        <div class="flex flex-wrap gap-2 mb-4" id="capability-pack-tabs">
          <button data-pack="lighting" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors">
            🔦 Lighting
          </button>
          <button data-pack="seismic" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors opacity-40 cursor-not-allowed" disabled title="No seismic capability deployed">
            📊 Seismic
          </button>
          <button data-pack="hydrophone" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors">
            🌊 Hydrophone
          </button>
          <button data-pack="talkback" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors">
            📢 Talkback
          </button>
        </div>
        
        <!-- Capability Pack Panels -->
        <div id="capability-pack-panels">
          <div data-panel="lighting" class="capability-panel hidden">
            <LightingControlPanel lightingStates={{}} client:load />
          </div>
          <div data-panel="hydrophone" class="capability-panel hidden">
            <HydrophonePanel hydrophoneData={{ hydrophones: [], detections: [] }} client:load />
          </div>
          <div data-panel="talkback" class="capability-panel hidden">
            <TalkbackPanel talkbackData={{ capability: { talkback_available: false, speaker_available: false, microphone_available: false, available_agents: [] }, messages: [], responses: [] }} client:load />
          </div>
        </div>
      </div>

      <!-- Detection Detail Modal -->
      <DetectionDetailModal client:load />
      
      <!-- Agent Detail Modal -->
      <AgentDetailModal />

      <!-- Lower Dashboard Grid -->
      <div class="grid lg:grid-cols-1 gap-6 mt-6">
        <!-- AI Analysis Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700 lg:col-span-2">
          <h2 class="text-2xl font-bold mb-4">AI Analysis</h2>
          <div class="space-y-3">
            <div>
              <span class="text-slate-400 block mb-2">Summary:</span>
              <p id="ai-summary" class="text-slate-100">Loading...</p>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Confidence:</span>
              <span id="ai-confidence" class="font-semibold">--</span>
            </div>
          </div>
        </div>

        <!-- Events Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700 lg:col-span-2">
          <h2 class="text-2xl font-bold mb-4">
            Mission Events 
            <span class="text-sm font-normal text-slate-400">(<span id="event-count">0</span> events)</span>
          </h2>
          <div id="events-container" class="space-y-2">
            <p class="text-slate-400">No events yet...</p>
          </div>
        </div>
      </div>

      <!-- Debug Panel -->
      <div class="mt-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
        <details>
          <summary class="cursor-pointer text-sm text-slate-400 hover:text-slate-300">
            Debug Information
          </summary>
          <div class="mt-3">
            <p class="text-xs text-slate-500 mb-2">Last API Response:</p>
            <pre id="debug-json" class="text-xs bg-slate-900 p-3 rounded overflow-auto max-h-96"></pre>
          </div>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initializeSimulation } from '../../../lib/simulation-manager';
  import { initializeTacticalMapWithDigitalTwin, updateTacticalMap } from '../../../lib/tactical-map-manager';
  import { initDetectionModalManager, updateDetectionData } from '../../../lib/detection-modal-manager';
  import { initAgentModalManager, showAgentModal } from '../../../lib/agent-modal-manager';
  import { renderInteractiveActions } from '../../../lib/recommended-actions-manager';
  import { initializeRouteProfile, updateRouteProfile } from '../../../lib/route-profile-renderer';
  import { adaptToRouteProfile } from '../../../lib/tactical-map/routeProfileAdapter';
  import { getTerrainSectors, getTerrainPaths, getWaypoints } from '../../../lib/api';
  import { getTerrainBinding } from '../../../lib/tactical-map/useCaseTerrainBindings';
  import { createPanZoomController } from '../../../lib/tactical-map-pan-zoom';
  
  const MISSION_PK = document.querySelector('[data-mission-pk]')?.getAttribute('data-mission-pk') || '';
  const manager = initializeSimulation(MISSION_PK);
  
  // Initialize tactical map with Digital Twin terrain (async)
  let mapConfig: any;
  let panZoomController: any;
  (async () => {
    mapConfig = await initializeTacticalMapWithDigitalTwin('flooded-structure');
    
    // Enable pan/zoom controls
    const svgElement = document.getElementById('tactical-map-svg') as SVGSVGElement;
    if (svgElement) {
      panZoomController = createPanZoomController(svgElement, 'map-content', {
        minScale: 0.5,
        maxScale: 5,
        zoomSpeed: 0.15,
      });
      panZoomController.enable();
      
      // Wire up UI controls
      document.getElementById('map-zoom-in')?.addEventListener('click', () => {
        const state = panZoomController.getState();
        panZoomController.setState({ scale: state.scale * 1.3 });
      });
      
      document.getElementById('map-zoom-out')?.addEventListener('click', () => {
        const state = panZoomController.getState();
        panZoomController.setState({ scale: state.scale / 1.3 });
      });
      
      document.getElementById('map-reset-view')?.addEventListener('click', () => {
        panZoomController.reset();
      });
    }
    
    // Initialize route profile with Digital Twin data
    try {
      const binding = getTerrainBinding('flooded-structure');
      if (binding && binding.terrainMapSlug) {
        const [sectorsResult, pathsResult, waypointsResult] = await Promise.all([
          getTerrainSectors(binding.terrainMapSlug),
          getTerrainPaths(binding.terrainMapSlug),
          getWaypoints(binding.terrainMapSlug)
        ]);
        
        if (sectorsResult.success && sectorsResult.data) {
          // Handle paginated response from Django REST Framework
          const sectors = Array.isArray(sectorsResult.data) ? sectorsResult.data : (sectorsResult.data as any).results || [];
          const paths = pathsResult.success ? (Array.isArray(pathsResult.data) ? pathsResult.data : (pathsResult.data as any).results || []) : [];
          const waypoints = waypointsResult.success ? (Array.isArray(waypointsResult.data) ? waypointsResult.data : (waypointsResult.data as any).results || []) : [];
          
          const routeProfileViewModel = adaptToRouteProfile(
            sectors,
            paths,
            waypoints,
            undefined,
            'Main Deck Entry'
          );
          initializeRouteProfile(routeProfileViewModel, { containerId: 'route-profile' });
        }
      }
    } catch (err) {
      console.error('Route profile initialization failed:', err);
      const loadingEl = document.getElementById('route-profile-loading');
      if (loadingEl) loadingEl.textContent = 'Failed to load route profile';
    }
  
    // Initialize detection modal manager
    initDetectionModalManager();
  
    // Initialize agent modal manager
    initAgentModalManager();
  
    // Listen for agent marker clicks
    window.addEventListener('agent-marker-clicked', (event: Event) => {
      const customEvent = event as CustomEvent;
      if (customEvent.detail?.agent) {
        showAgentModal(customEvent.detail.agent);
      }
    });
  })(); // End async IIFE
  
  const originalPoll = (manager as any).poll;
  (manager as any).poll = async function() {
    try {
      await originalPoll.call(this);
      
      const state = this.getLastState();
      if (!state) return;
      
      // Update mission clock
      const clockEl = document.getElementById('mission-clock-time');
      if (clockEl && state.simulation_clock) {
        const elapsed = state.simulation_clock.elapsed_seconds;
        const minutes = Math.floor(elapsed / 60);
        const seconds = Math.floor(elapsed % 60);
        clockEl.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      }
      
      // Update agents display
      const agentsContainer = document.getElementById('agents-container');
      if (agentsContainer && state.agents) {
        agentsContainer.innerHTML = state.agents.map(agent => `
          <div class="p-4 bg-slate-700 rounded-lg">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h3 class="font-semibold">${agent.name}</h3>
                <p class="text-xs text-slate-400">${agent.role}</p>
              </div>
              <span data-agent-state="${agent.agent_id}" class="px-2 py-1 rounded text-xs font-semibold bg-slate-800 text-slate-300">
                ${agent.state}
              </span>
            </div>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Battery:</span>
                <span data-agent-battery="${agent.agent_id}">${agent.battery_percent}%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Signal:</span>
                <span data-agent-signal="${agent.agent_id}">${agent.signal_strength}%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Location:</span>
                <span class="text-xs">${agent.location_label}</span>
              </div>
              ${agent.nfc_recovery_available ? '<div class="text-xs text-yellow-400 mt-2 flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> NFC recovery available</div>' : ''}
            </div>
            <div class="mt-2 h-2 bg-slate-900 rounded-full overflow-hidden">
              <div 
                data-agent-battery-bar="${agent.agent_id}"
                class="h-full bg-green-500 transition-all duration-500"
                style="width: ${agent.battery_percent}%"
              ></div>
            </div>
          </div>
        `).join('');
      }
      
      // Update events display
      const eventsContainer = document.getElementById('events-container');
      if (eventsContainer && state.events) {
        if (state.events.length === 0) {
          eventsContainer.innerHTML = '<p class="text-slate-400">No events yet...</p>';
        } else {
          eventsContainer.innerHTML = state.events.slice().reverse().map(event => `
            <div class="p-3 bg-slate-700 rounded-lg text-sm">
              <div class="flex justify-between items-start mb-1">
                <span class="font-semibold">${event.title}</span>
                <span class="text-xs text-slate-400">${event.time}</span>
              </div>
              <p class="text-slate-300 text-xs">${event.description}</p>
            </div>
          `).join('');
        }
      }
      
      // Update tactical map
      updateTacticalMap(state, mapConfig);
      
      // Update route profile
      (async () => {
        try {
          const binding = getTerrainBinding('flooded-structure');
          if (binding && binding.terrainMapSlug) {
            const [sectorsResult, pathsResult, waypointsResult] = await Promise.all([
              getTerrainSectors(binding.terrainMapSlug),
              getTerrainPaths(binding.terrainMapSlug),
              getWaypoints(binding.terrainMapSlug)
            ]);
            
            if (sectorsResult.success && sectorsResult.data) {
              // Handle paginated response from Django REST Framework
              const sectors = Array.isArray(sectorsResult.data) ? sectorsResult.data : (sectorsResult.data as any).results || [];
              const paths = pathsResult.success ? (Array.isArray(pathsResult.data) ? pathsResult.data : (pathsResult.data as any).results || []) : [];
              const waypoints = waypointsResult.success ? (Array.isArray(waypointsResult.data) ? waypointsResult.data : (waypointsResult.data as any).results || []) : [];
              
              const routeProfileViewModel = adaptToRouteProfile(
                sectors,
                paths,
                waypoints,
                state,
                'Main Deck Entry'
              );
              updateRouteProfile(routeProfileViewModel, { containerId: 'route-profile' });
            }
          }
        } catch (err) {
          console.error('Route profile update failed:', err);
        }
      })();
      
      // Update detection data for modal manager
      updateDetectionData(state);
      
      // Update media feeds - dispatch custom event for React component
      if (state.media_feeds) {
        window.dispatchEvent(new CustomEvent('media-feeds-update', {
          detail: { mediaFeeds: state.media_feeds }
        }));
      }
      
      // Update capability pack panels
      const capabilityPacks = {
        lighting: state.lighting || null,
        hydrophone: state.hydrophone || null,
        talkback: state.talkback || null
      };
      
      // Update tab states (active vs disabled)
      Object.entries(capabilityPacks).forEach(([pack, data]) => {
        const tab = document.querySelector(`button[data-pack="${pack}"]`);
        if (tab) {
          const hasData = data && (
            (pack === 'lighting' && Object.keys(data).length > 0) ||
            (pack === 'hydrophone' && (data.hydrophones?.length > 0 || data.detections?.length > 0)) ||
            (pack === 'talkback' && (data.messages?.length > 0 || data.responses?.length > 0))
          );
          
          if (hasData) {
            tab.classList.remove('opacity-40', 'cursor-not-allowed');
            tab.classList.add('hover:bg-slate-600');
            tab.disabled = false;
          } else {
            tab.classList.add('opacity-40', 'cursor-not-allowed');
            tab.classList.remove('hover:bg-slate-600');
            tab.disabled = true;
          }
        }
      });
      
      // Dispatch capability pack updates
      if (capabilityPacks.lighting) {
        window.dispatchEvent(new CustomEvent('lighting-update', {
          detail: { lightingStates: capabilityPacks.lighting }
        }));
      }
      if (capabilityPacks.hydrophone) {
        window.dispatchEvent(new CustomEvent('hydrophone-update', {
          detail: { hydrophoneData: capabilityPacks.hydrophone }
        }));
      }
      if (capabilityPacks.talkback) {
        window.dispatchEvent(new CustomEvent('talkback-update', {
          detail: { talkbackData: capabilityPacks.talkback }
        }));
      }
      
      // Update audio detections panel
      if (state.audio_detections) {
        // Transform backend format to frontend format
        const transformedDetections = state.audio_detections.map((detection: any) => ({
          id: detection.id,
          agent_id: detection.agent_id,
          agent_name: detection.agent_name,
          sensor_type: 'microphone' as const,
          audio_type: detection.type,
          status: detection.status,
          mission_time: detection.detected_at,
          signal_quality: detection.confidence,
          confidence: detection.confidence,
          location_label: detection.location,
          annotations: detection.human_review_required ? ['Requires human review'] : [],
          description: detection.description,
          audio_url: undefined,
          spectrogram_url: undefined
        }));
        
        window.dispatchEvent(new CustomEvent('audio-detections-update', {
          detail: { audioDetections: transformedDetections }
        }));
      }
      
      // Update debug panel
      const debugEl = document.getElementById('debug-json');
      if (debugEl) {
        debugEl.textContent = JSON.stringify(state, null, 2);
      }
    } catch (error) {
      console.error('Error in poll override:', error);
    }
  };
  
  console.log('Flooded structure simulation manager initialized');
  
  // Capability pack tab switching
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.capability-pack-tab');
    const panels = document.querySelectorAll('.capability-panel');
    
    // Show first enabled tab by default
    const firstEnabledTab = Array.from(tabs).find(tab => !tab.disabled);
    if (firstEnabledTab) {
      const pack = firstEnabledTab.getAttribute('data-pack');
      firstEnabledTab.classList.add('bg-rescue-600', 'font-semibold');
      firstEnabledTab.classList.remove('bg-slate-700');
      document.querySelector(`[data-panel="${pack}"]`)?.classList.remove('hidden');
    }
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        if (tab.disabled) return;
        
        const pack = tab.getAttribute('data-pack');
        
        // Update tab styles
        tabs.forEach(t => {
          t.classList.remove('bg-rescue-600', 'font-semibold');
          t.classList.add('bg-slate-700');
        });
        tab.classList.add('bg-rescue-600', 'font-semibold');
        tab.classList.remove('bg-slate-700');
        
        // Show corresponding panel
        panels.forEach(p => p.classList.add('hidden'));
        document.querySelector(`[data-panel="${pack}"]`)?.classList.remove('hidden');
      });
    });
  });
</script>
</BaseLayout>
