---
/**
 * Live Collapsed Building Search Mission Dashboard
 * 
 * **Primary interactive mission visualization page for the collapsed building scenario.**
 * 
 * This page demonstrates the complete RescueMesh platform capabilities:
 * - Real-time mission state polling from Django API
 * - Interactive tactical map with pan/zoom
 * - Agent status tracking (battery, signal, state)
 * - Sensor detections (thermal, audio, gas)
 * - Communication network visualization
 * - Timeline events
 * - AI analysis and recommendations
 * - Mission control (start, pause, reset, speed control)
 * 
 * **Architecture:**
 * 
 * Frontend (Astro + React islands):
 * - Static page shell rendered at build time
 * - Interactive components hydrated via `client:load`
 * - Polls `/api/v1/missions/{MISSION_PK}/state/` every 2 seconds
 * - Updates all visualizations synchronously on each poll
 * 
 * Backend (Django):
 * - Calculates mission state on-demand (deterministic simulation)
 * - No WebSockets, no background tasks (yet)
 * - State computed from elapsed_seconds + use_case_slug
 * 
 * **Mission Flow:**
 * 
 * 1. Page loads → Initial state fetch (status: 'not_started', elapsed: 0)
 * 2. User clicks "Start Simulation" → POST /start-sim/
 * 3. Polling loop begins → GET /state/ every 2 seconds
 * 4. Each state update triggers all render functions
 * 5. Mission progresses: agents move → map reveals → detections appear → events accumulate
 * 6. User can pause/resume/reset or adjust speed multiplier
 * 
 * **Scenario: Collapsed Building Search**
 * 
 * Mission ID: c5d0ffd4-2fc8-4b45-841d-88ec93f27e8e
 * Scenario: collapsed-building-alpha-01
 * 
 * Timeline:
 * - 0s: Mission start, Relay Node 1 deployed at entrance
 * - 30s: Drone A (scout) enters ground floor
 * - 60s: Ground floor corridor mapped
 * - 120s: Drone B (relay) enters, begins exploring
 * - 180s: Stairwell discovered, descent begins
 * - 240s: Basement corridor entered
 * - 320s: **Thermal anomaly detected** (🔥 potential survivor)
 * - 350s: **Audio event detected** (🔊 possible voice-like signal)
 * - 420s: Drone B battery critical → lands and becomes relay node
 * - 480s: Drone C (thermal specialist) enters
 * - 550s: Drone C enters priority streaming mode (one-way mission critical data)
 * - 600s+: Mission continues with network routing around landed Drone B
 * 
 * **Key Components:**
 * 
 * - SimulationControls: Start/pause/reset, speed control, mission clock
 * - TacticalMap: SVG visualization with sectors, agents, network, detections
 * - MediaFeedsPanel: Thermal camera feeds (React island)
 * - AudioDetectionsPanel: Audio spectrum analysis (React island)
 * - DetectionDetailModal: Detailed detection information (React island)
 * - AgentDetailModal: Individual agent status and telemetry
 * - DistanceLinkBudgetPanel: Communication range analysis (React island)
 * - RouteProfile: Vertical elevation/depth visualization
 * 
 * **Polling Implementation:**
 * 
 * The page polls the Django API every 2 seconds to fetch mission state.
 * See the bottom script tag for the setInterval implementation.
 * Updates tactical map, agents panel, timeline, and all visualizations.
 * 
 * **Performance:**
 * 
 * - API response time: ~20-50ms (cached scenario data)
 * - Rendering time: ~5-15ms (SVG updates)
 * - Total update cycle: <100ms typical
 * - Polling every 2 seconds feels smooth for demo purposes
 * - Future: WebSockets for true real-time sub-100ms updates
 * 
 * **Constants:**
 * 
 * - MISSION_PK: UUID identifying this mission in Django database
 * - USE_CASE: 'collapsed-building-search' (determines map config)
 * - TITLE: Human-readable mission name for UI display
 * 
 * **Navigation:**
 * 
 * - Back to: /demo (demo overview page)
 * - View static profile: /demo/collapsed-building-search
 * - Switch scenarios: /demo/live/{other-use-case}
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SimulationControls from '../../../components/demo/SimulationControls.astro';
import TacticalMap from '../../../components/demo/TacticalMap.astro';
import DataSourceBadge from '../../../components/demo/DataSourceBadge.astro';
import EscalationBanner from '../../../components/demo/EscalationBanner.astro';
import RecommendedActions from '../../../components/demo/RecommendedActions.astro';
import MediaFeedsPanel from '../../../components/islands/MediaFeedsPanel';
import AudioDetectionsPanel from '../../../components/islands/AudioDetectionsPanel';
import DetectionDetailModal from '../../../components/islands/DetectionDetailModal';
import AgentDetailModal from '../../../components/demo/AgentDetailModal.astro';
import DistanceLinkBudgetPanel from '../../../components/islands/DistanceLinkBudgetPanel';
import RouteProfile from '../../../components/demo/RouteProfile.astro';
import LightingControlPanel from '../../../components/islands/LightingControlPanel';
import SeismicMonitoringPanel from '../../../components/islands/SeismicMonitoringPanel';
import TalkbackPanel from '../../../components/islands/TalkbackPanel';

// Mission configuration constants
const MISSION_PK = 'c5d0ffd4-2fc8-4b45-841d-88ec93f27e8e';  // Django mission UUID
const USE_CASE = 'collapsed-building-search';                // Map config identifier
const TITLE = 'Collapsed Building Search';                   // Display name

// Initial mission clock state (before API fetch)
const initialClock = {
  started_at: null,              // Real-world start time (ISO 8601)
  elapsed_seconds: 0,            // Mission elapsed time
  speed_multiplier: 1.0,         // Simulation speed (1x, 2x, 5x, 10x)
  is_running: false,             // Simulation status
};
---

<BaseLayout 
  title={`Live Simulation - ${TITLE}`}
  description="Real-time collapsed building search simulation with Django API"
>
  <div class="min-h-screen bg-slate-900 text-slate-100 py-8 px-4 sm:px-6 lg:px-8" data-mission-pk={MISSION_PK}>
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <a href="/demo" class="text-rescue-400 hover:text-rescue-300 text-sm mb-4 inline-block">
          ← Back to Demo Overview
        </a>
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div>
            <h1 class="text-4xl font-bold mb-2">Live Simulation: {TITLE}</h1>
            <p class="text-slate-400">GPS-denied collapsed building search and rescue</p>
            <a href="/demo/collapsed-building-search" class="text-xs text-slate-500 hover:text-slate-400 mt-1 inline-block">
              View static profile →
            </a>
          </div>
          <DataSourceBadge source="django" />
        </div>
      </div>

      <!-- Use Case Navigation -->
      <div class="mb-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-sm font-semibold mb-2">Switch Use Case:</div>
        <div class="flex flex-wrap gap-2">
          <a href="/demo/live/collapsed-building-search" class="px-4 py-2 bg-rescue-600 rounded text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-300">
            Collapsed Building
          </a>
          <a href="/demo/live/cave-rescue" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400">
            Cave Rescue
          </a>
          <a href="/demo/live/flooded-structure" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400">
            Flooded Structure
          </a>
          <a href="/demo/live/industrial-inspection" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400">
            Industrial Inspection
          </a>
          <a href="/demo/live/archaeological-exploration" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400">
            Archaeological Exploration
          </a>
        </div>
      </div>

      <!-- Simulation Controls -->
      <div class="mb-8">
        <SimulationControls clock={initialClock} missionPk={MISSION_PK} />
      </div>

      <!-- Mission Escalation Banner (dynamically populated) -->
      <div id="escalation-banner-container"></div>

      <!-- Recommended Actions Panel (dynamically populated) -->
      <div id="recommended-actions-container" class="mb-8"></div>

      <!-- Tactical Map -->
      <div id="tactical-map-container" class="mb-8">
        <TacticalMap useCase={USE_CASE} />
      </div>

      <!-- Route Profile -->
      <div id="route-profile-container" class="mb-8">
        <RouteProfile containerId="route-profile" title="Route Profile — Vertical View" />
      </div>

      <!-- Dashboard Grid -->
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Agent Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Agent Status</h2>
          <div id="agents-container" class="space-y-4">
            <p class="text-slate-400">Loading agents...</p>
          </div>
        </div>

        <!-- Network Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Network Status</h2>
          
          <!-- Network Health Indicator -->
          <div class="mb-4 p-3 rounded-lg" id="network-health-indicator">
            <div class="flex items-center gap-2">
              <span class="text-2xl" id="network-health-icon">🟢</span>
              <span class="font-semibold" id="network-health-label">Healthy</span>
            </div>
          </div>

          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Mesh Health:</span>
              <span id="mesh-health" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Packet Loss:</span>
              <span id="packet-loss" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Base Signal:</span>
              <span id="base-signal" class="font-semibold">--</span>
            </div>
          </div>

          <!-- Active Relay Chain -->
          <div class="mt-4 pt-4 border-t border-slate-700">
            <h3 class="text-sm font-semibold text-slate-400 mb-2">Active Relay Chain</h3>
            <div id="relay-chain" class="space-y-1 text-sm">
              <p class="text-slate-500">No relays active</p>
            </div>
          </div>
        </div>

        <!-- Map Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Map Status</h2>
          <div class="space-y-3">
            <div class="flex justify-between">
              <div class="flex items-center gap-1.5 group relative">
                <span class="text-slate-400">Sectors Mapped:</span>
                <svg class="w-4 h-4 text-slate-500 cursor-help" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-slate-900 border border-slate-600 rounded-lg text-xs text-slate-300 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 shadow-xl">
                  <p class="font-semibold text-slate-100 mb-1">Sectors Mapped</p>
                  <p>Percentage of terrain sectors that have been explored by agents. Shows mission progress toward complete coverage.</p>
                </div>
              </div>
              <span id="map-coverage" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <div class="flex items-center gap-1.5 group relative">
                <span class="text-slate-400">SLAM Confidence:</span>
                <svg class="w-4 h-4 text-slate-500 cursor-help" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-slate-900 border border-slate-600 rounded-lg text-xs text-slate-300 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 shadow-xl">
                  <p class="font-semibold text-slate-100 mb-1">SLAM Confidence</p>
                  <p>Reliability of the Simultaneous Localization and Mapping system. Can degrade due to dust, feature-poor passages, or accumulated positioning error.</p>
                </div>
              </div>
              <span id="map-confidence" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <div class="flex items-center gap-1.5 group relative">
                <span class="text-slate-400">Total Points:</span>
                <svg class="w-4 h-4 text-slate-500 cursor-help" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-slate-900 border border-slate-600 rounded-lg text-xs text-slate-300 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 shadow-xl">
                  <p class="font-semibold text-slate-100 mb-1">Total Points</p>
                  <p>Approximate LiDAR point cloud density captured during mapping (~1,000 points per explored sector). Represents the 3D measurement data collected.</p>
                </div>
              </div>
              <span id="map-points" class="font-semibold">--</span>
            </div>
          </div>
        </div>

        <!-- Sensor Data Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Sensor Data</h2>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Thermal Anomalies:</span>
              <span id="thermal-count" class="font-semibold">0</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Audio Events:</span>
              <span id="audio-count" class="font-semibold">0</span>
            </div>
          </div>
        </div>

        <!-- Atmosphere Sensors Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Atmosphere Sensors</h2>
          <p class="text-xs text-slate-400 mb-4">Confined space atmosphere monitoring for survivor detection</p>
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Oxygen (O₂):</span>
              <span id="o2-reading" class="font-semibold text-slate-500 text-sm italic">No sensor deployed</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Carbon Dioxide (CO₂):</span>
              <span id="co2-reading" class="font-semibold text-slate-500 text-sm italic">No sensor deployed</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Media Feeds Panel -->
      <div class="mt-6">
        <MediaFeedsPanel mediaFeeds={[]} client:load />
      </div>

      <!-- Audio Detections Panel -->
      <div class="mt-6">
        <AudioDetectionsPanel missionId={MISSION_PK} client:load />
      </div>

      <!-- Distance & Link Budget Panel -->
      <div class="mt-6">
        <DistanceLinkBudgetPanel client:load />
      </div>

      <!-- Capability Packs Section -->
      <div class="mt-6">
        <h2 class="text-2xl font-bold mb-4">Capability Packs</h2>
        <div class="flex flex-wrap gap-2 mb-4" id="capability-pack-tabs">
          <button data-pack="lighting" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors">
            🔦 Lighting
          </button>
          <button data-pack="seismic" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors">
            📊 Seismic
          </button>
          <button data-pack="hydrophone" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors opacity-40 cursor-not-allowed" disabled title="No hydrophone capability deployed">
            🌊 Hydrophone
          </button>
          <button data-pack="talkback" class="capability-pack-tab px-4 py-2 rounded bg-slate-700 hover:bg-slate-600 transition-colors">
            📢 Talkback
          </button>
        </div>
        
        <!-- Capability Pack Panels -->
        <div id="capability-pack-panels">
          <div data-panel="lighting" class="capability-panel hidden">
            <LightingControlPanel lightingStates={{}} client:load />
          </div>
          <div data-panel="seismic" class="capability-panel hidden">
            <SeismicMonitoringPanel seismicData={{ sensors: [], detections: [] }} client:load />
          </div>
          <div data-panel="talkback" class="capability-panel hidden">
            <TalkbackPanel talkbackData={{ capability: { talkback_available: false, speaker_available: false, microphone_available: false, available_agents: [] }, messages: [], responses: [] }} client:load />
          </div>
        </div>
      </div>

      <!-- Detection Detail Modal -->
      <DetectionDetailModal client:load />
      
      <!-- Agent Detail Modal -->
      <AgentDetailModal />

      <!-- Lower Dashboard Grid -->
      <div class="grid lg:grid-cols-1 gap-6 mt-6">

        <!-- AI Analysis Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700 lg:col-span-2">
          <h2 class="text-2xl font-bold mb-4">AI Analysis</h2>
          <div class="space-y-3">
            <div>
              <span class="text-slate-400 block mb-2">Summary:</span>
              <p id="ai-summary" class="text-slate-100">Loading...</p>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Confidence:</span>
              <span id="ai-confidence" class="font-semibold">--</span>
            </div>
          </div>
        </div>

        <!-- Events Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700 lg:col-span-2">
          <h2 class="text-2xl font-bold mb-4">
            Mission Events 
            <span class="text-sm font-normal text-slate-400">(<span id="event-count">0</span> events)</span>
          </h2>
          <div id="events-container" class="space-y-2">
            <p class="text-slate-400">No events yet...</p>
          </div>
        </div>
      </div>

      <!-- Debug Panel (optional, can be removed later) -->
      <div class="mt-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
        <details>
          <summary class="cursor-pointer text-sm text-slate-400 hover:text-slate-300">
            Debug Information
          </summary>
          <div class="mt-3">
            <p class="text-xs text-slate-500 mb-2">Last API Response:</p>
            <pre id="debug-json" class="text-xs bg-slate-900 p-3 rounded overflow-auto max-h-96"></pre>
          </div>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { formatCompactMissionTime, initializeSimulation } from '../../../lib/simulation-manager';
  import { initializeTacticalMapWithDigitalTwin, updateTacticalMap } from '../../../lib/tactical-map-manager';
  import { initDetectionModalManager, updateDetectionData } from '../../../lib/detection-modal-manager';
  import { initAgentModalManager, showAgentModal } from '../../../lib/agent-modal-manager';
  import { renderInteractiveActions } from '../../../lib/recommended-actions-manager';
  import { initializeLiveRouteProfile, updateLiveRouteProfile } from '../../../lib/route-profile-manager';
  import {
    dispatchAudioDetections,
    dispatchMediaFeeds,
    initializeCapabilityPackTabs,
    renderAgentStatusPanel,
    renderEscalationBanner,
    renderEnvironmentalReadings,
    renderMissionEvents,
    updateCapabilityPacks
  } from '../../../lib/live-demo-renderers';
  import { initializeTacticalMapPanZoom } from '../../../lib/live-demo-tactical-map';
  
  const MISSION_PK = document.querySelector('[data-mission-pk]')?.getAttribute('data-mission-pk') || '';
  const manager = initializeSimulation(MISSION_PK);
  
  // Initialize tactical map with Digital Twin terrain (async)
  let mapConfig: any;
  (async () => {
    mapConfig = await initializeTacticalMapWithDigitalTwin('collapsed-building-search');
    
    initializeTacticalMapPanZoom();
    
    await initializeLiveRouteProfile('collapsed-building-search', {
      containerId: 'route-profile',
      originLabel: 'Ground Level Entry'
    });
  
    // Initialize detection modal manager
    initDetectionModalManager();
  
    // Initialize agent modal manager
    initAgentModalManager();
  
    // Listen for agent marker clicks
    window.addEventListener('agent-marker-clicked', (event: Event) => {
      const customEvent = event as CustomEvent;
      if (customEvent.detail?.agent) {
        showAgentModal(customEvent.detail.agent);
      }
    });
  })();
  
  // Enhanced UI update function to show agents
  // This is a temporary extension until we refactor to a proper framework
  const originalPoll = (manager as any).poll;
  (manager as any).poll = async function() {
    try {
      await originalPoll.call(this);
      
      const state = this.getLastState();
      if (!state) return;
      
      // Update mission clock
      const clockEl = document.getElementById('mission-clock-time');
      if (clockEl && state.simulation_clock) {
        clockEl.textContent = formatCompactMissionTime(state.simulation_clock.elapsed_seconds);
      }
      
      renderAgentStatusPanel(state.agents);
      
      renderMissionEvents(state.events);
      
      // Update tactical map
      updateTacticalMap(state, mapConfig);
      
      await updateLiveRouteProfile('collapsed-building-search', state, {
        containerId: 'route-profile',
        originLabel: 'Ground Level Entry'
      });
      
      // Update detection data for modal manager
      updateDetectionData(state);
      
      // Handle escalation and recommended actions
      if (state.escalation) {
        renderEscalationBanner(state.escalation);
        renderInteractiveActions(state.escalation, 'recommended-actions-container');
      }
      
      renderEnvironmentalReadings(state.sensors?.environmental_readings, {
        oxygen: 'o2-reading',
        carbon_dioxide: 'co2-reading'
      });
      
      dispatchMediaFeeds(state.media_feeds);
      
      updateCapabilityPacks({
        lighting: state.lighting || null,
        seismic: state.seismic || null,
        talkback: state.talkback || null
      });
      
      dispatchAudioDetections(state.audio_detections);
      
      // Update debug panel
      const debugEl = document.getElementById('debug-json');
      if (debugEl) {
        debugEl.textContent = JSON.stringify(state, null, 2);
      }
    } catch (error) {
      console.error('Error in poll override:', error);
    }
  };
  
  console.log('Simulation manager initialized for mission:', MISSION_PK);
  
  initializeCapabilityPackTabs();
</script>
