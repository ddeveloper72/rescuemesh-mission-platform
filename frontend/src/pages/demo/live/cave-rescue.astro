---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SimulationControls from '../../../components/demo/SimulationControls.astro';
import TacticalMap from '../../../components/demo/TacticalMap.astro';
import DataSourceBadge from '../../../components/demo/DataSourceBadge.astro';
import EscalationBanner from '../../../components/demo/EscalationBanner.astro';
import RecommendedActions from '../../../components/demo/RecommendedActions.astro';
import MediaFeedsPanel from '../../../components/islands/MediaFeedsPanel';
import AudioDetectionsPanel from '../../../components/islands/AudioDetectionsPanel';
import DetectionDetailModal from '../../../components/islands/DetectionDetailModal';
import AgentDetailModal from '../../../components/demo/AgentDetailModal.astro';
import DistanceLinkBudgetPanel from '../../../components/islands/DistanceLinkBudgetPanel';

const MISSION_PK = '063218cf-7662-4675-8337-edabd204b793';
const USE_CASE = 'cave-rescue';
const TITLE = 'Cave Rescue';

const initialClock = {
  started_at: null,
  elapsed_seconds: 0,
  speed_multiplier: 1.0,
  is_running: false,
};
---

<BaseLayout 
  title={`Live Simulation - ${TITLE}`}
  description="Real-time cave rescue simulation with Django API"
>
  <div class="min-h-screen bg-slate-900 text-slate-100 py-8 px-4 sm:px-6 lg:px-8" data-mission-pk={MISSION_PK}>
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <a href="/demo" class="text-rescue-400 hover:text-rescue-300 text-sm mb-4 inline-block">
          ← Back to Demo Overview
        </a>
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div>
            <h1 class="text-4xl font-bold mb-2">Live Simulation: {TITLE}</h1>
            <p class="text-slate-400">GPS-denied cave mapping and search</p>
            <a href="/demo/cave-rescue" class="text-xs text-slate-500 hover:text-slate-400 mt-1 inline-block">
              View static profile →
            </a>
          </div>
          <DataSourceBadge source="django" />
        </div>
      </div>

      <!-- Use Case Navigation -->
      <div class="mb-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-sm font-semibold mb-2">Switch Use Case:</div>
        <div class="flex flex-wrap gap-2">
          <a href="/demo/live/collapsed-building-search" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors">
            Collapsed Building
          </a>
          <a href="/demo/live/cave-rescue" class="px-4 py-2 bg-rescue-600 rounded text-sm font-semibold">
            Cave Rescue
          </a>
          <a href="/demo/live/flooded-structure" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors">
            Flooded Structure
          </a>
          <a href="/demo/live/industrial-inspection" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors">
            Industrial Inspection
          </a>
        </div>
      </div>

      <!-- Simulation Controls -->
      <div class="mb-8">
        <SimulationControls clock={initialClock} missionPk={MISSION_PK} />
      </div>

      <!-- Mission Escalation Banner (dynamically populated) -->
      <div id="escalation-banner-container"></div>

      <!-- Recommended Actions Panel (dynamically populated) -->
      <div id="recommended-actions-container" class="mb-8"></div>

      <!-- Tactical Map -->
      <div id="tactical-map-container" class="mb-8">
        <TacticalMap useCase={USE_CASE} />
      </div>

      <!-- Dashboard Grid -->
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Agent Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Agent Status</h2>
          <div id="agents-container" class="space-y-4">
            <p class="text-slate-400">Loading agents...</p>
          </div>
        </div>

        <!-- Network Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Network Status</h2>
          
          <!-- Network Health Indicator -->
          <div class="mb-4 p-3 rounded-lg" id="network-health-indicator">
            <div class="flex items-center gap-2">
              <span class="text-2xl" id="network-health-icon">🟢</span>
              <span class="font-semibold" id="network-health-label">Healthy</span>
            </div>
          </div>

          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Mesh Health:</span>
              <span id="mesh-health" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Packet Loss:</span>
              <span id="packet-loss" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Base Signal:</span>
              <span id="base-signal" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between items-center mt-4 pt-4 border-t border-slate-700">
              <span class="text-slate-400">Contact Continuity:</span>
              <span id="contact-continuity-risk" class="font-semibold px-2 py-1 rounded text-sm">--</span>
            </div>
          </div>

          <!-- Active Relay Chain -->
          <div class="mt-4 pt-4 border-t border-slate-700">
            <h3 class="text-sm font-semibold text-slate-400 mb-2">Active Relay Chain</h3>
            <div id="relay-chain" class="space-y-1 text-sm">
              <p class="text-slate-500">No relays active</p>
            </div>
          </div>
        </div>

        <!-- Map Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Cave Map Status</h2>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Coverage:</span>
              <span id="map-coverage" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">SLAM Confidence:</span>
              <span id="map-confidence" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Total Points:</span>
              <span id="map-points" class="font-semibold">--</span>
            </div>
          </div>
        </div>

        <!-- Environmental Sensors Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Atmosphere Sensors</h2>
          <p class="text-xs text-slate-400 mb-4">Cave atmosphere monitoring for ventilation and survivor detection</p>
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Oxygen (O₂):</span>
              <span id="o2-reading" class="font-semibold text-slate-500">--</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-400">Carbon Dioxide (CO₂):</span>
              <span id="co2-reading" class="font-semibold text-slate-500">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Audio Events:</span>
              <span id="audio-count" class="font-semibold">0</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Media Feeds Panel -->
      <div class="mt-6">
        <MediaFeedsPanel mediaFeeds={[]} client:load />
      </div>

      <!-- Audio Detections Panel -->
      <div class="mt-6">
        <AudioDetectionsPanel missionId={MISSION_PK} client:load />
      </div>

      <!-- Distance & Link Budget Panel -->
      <div class="mt-6">
        <DistanceLinkBudgetPanel client:load />
      </div>

      <!-- Detection Detail Modal -->
      <DetectionDetailModal client:load />
      
      <!-- Agent Detail Modal -->
      <AgentDetailModal />

      <!-- Lower Dashboard Grid -->
      <div class="grid lg:grid-cols-1 gap-6 mt-6">
        <!-- AI Analysis Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700 lg:col-span-2">
          <h2 class="text-2xl font-bold mb-4">AI Analysis</h2>
          <div class="space-y-3">
            <div>
              <span class="text-slate-400 block mb-2">Summary:</span>
              <p id="ai-summary" class="text-slate-100">Loading...</p>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Confidence:</span>
              <span id="ai-confidence" class="font-semibold">--</span>
            </div>
          </div>
        </div>

        <!-- Events Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700 lg:col-span-2">
          <h2 class="text-2xl font-bold mb-4">
            Mission Events 
            <span class="text-sm font-normal text-slate-400">(<span id="event-count">0</span> events)</span>
          </h2>
          <div id="events-container" class="space-y-2">
            <p class="text-slate-400">No events yet...</p>
          </div>
        </div>
      </div>

      <!-- Debug Panel -->
      <div class="mt-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
        <details>
          <summary class="cursor-pointer text-sm text-slate-400 hover:text-slate-300">
            Debug Information
          </summary>
          <div class="mt-3">
            <p class="text-xs text-slate-500 mb-2">Last API Response:</p>
            <pre id="debug-json" class="text-xs bg-slate-900 p-3 rounded overflow-auto max-h-96"></pre>
          </div>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { initializeSimulation } from '../../../lib/simulation-manager';
  import { initializeTacticalMapWithDigitalTwin, updateTacticalMap } from '../../../lib/tactical-map-manager';
  import { initDetectionModalManager } from '../../../lib/detection-modal-manager';
  import { initAgentModalManager, showAgentModal } from '../../../lib/agent-modal-manager';
  
  const MISSION_PK = document.querySelector('[data-mission-pk]')?.getAttribute('data-mission-pk') || '';
  const manager = initializeSimulation(MISSION_PK);
  
  // Initialize tactical map with Digital Twin terrain (async)
  (async () => {
    const mapConfig = await initializeTacticalMapWithDigitalTwin('cave-rescue');
  
    // Initialize detection modal manager
    initDetectionModalManager();
  
    // Initialize agent modal manager
    initAgentModalManager();
  
    // Listen for agent marker clicks
    window.addEventListener('agent-marker-clicked', (event: Event) => {
      const customEvent = event as CustomEvent;
      if (customEvent.detail?.agent) {
        showAgentModal(customEvent.detail.agent);
      }
    });
  })(); // End async IIFE
  
  // Enhanced UI update for environmental readings count
  const originalPoll = (manager as any).poll;
  (manager as any).poll = async function() {
    try {
      await originalPoll.call(this);
      
      const state = this.getLastState();
      if (!state) return;
      // Update agents display
      const agentsContainer = document.getElementById('agents-container');
      if (agentsContainer && state.agents) {
        agentsContainer.innerHTML = state.agents.map(agent => `
          <div class="p-4 bg-slate-700 rounded-lg">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h3 class="font-semibold">${agent.name}</h3>
                <p class="text-xs text-slate-400">${agent.role}</p>
              </div>
              <span data-agent-state="${agent.agent_id}" class="px-2 py-1 rounded text-xs font-semibold bg-slate-800 text-slate-300">
                ${agent.state}
              </span>
            </div>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Battery:</span>
                <span data-agent-battery="${agent.agent_id}">${agent.battery_percent}%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Signal:</span>
                <span data-agent-signal="${agent.agent_id}">${agent.signal_strength}%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Location:</span>
                <span class="text-xs">${agent.location_label}</span>
              </div>
              ${agent.nfc_recovery_available ? '<div class="text-xs text-yellow-400 mt-2 flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> NFC recovery available</div>' : ''}
            </div>
            <div class="mt-2 h-2 bg-slate-900 rounded-full overflow-hidden">
              <div 
                data-agent-battery-bar="${agent.agent_id}"
                class="h-full bg-green-500 transition-all duration-500"
                style="width: ${agent.battery_percent}%"
              ></div>
            </div>
          </div>
        `).join('');
      }
      
      // Update atmosphere sensors
      if (state.sensors && state.sensors.environmental_readings) {
        const readings = state.sensors.environmental_readings;
        
        const getStatusClass = (status: string) => {
          switch (status) {
            case 'normal': return 'text-green-400';
            case 'watch': return 'text-yellow-400';
            case 'warning': return 'text-orange-400';
            case 'critical': return 'text-red-400';
            default: return 'text-slate-300';
          }
        };
        
        const o2El = document.getElementById('o2-reading');
        const co2El = document.getElementById('co2-reading');
        
        const o2Reading = readings.find((r: any) => r.sensor_type === 'oxygen');
        if (o2Reading && o2El) {
          o2El.className = `font-semibold ${getStatusClass(o2Reading.status)}`;
          o2El.textContent = `${o2Reading.value}${o2Reading.unit}`;
        }
        
        const co2Reading = readings.find((r: any) => r.sensor_type === 'carbon_dioxide');
        if (co2Reading && co2El) {
          co2El.className = `font-semibold ${getStatusClass(co2Reading.status)}`;
          co2El.textContent = `${co2Reading.value}${co2Reading.unit}`;
        }
      }
      
      // Update events display
      const eventsContainer = document.getElementById('events-container');
      if (eventsContainer && state.events) {
        if (state.events.length === 0) {
          eventsContainer.innerHTML = '<p class="text-slate-400">No events yet...</p>';
        } else {
          eventsContainer.innerHTML = state.events.slice().reverse().map(event => `
            <div class="p-3 bg-slate-700 rounded-lg text-sm">
              <div class="flex justify-between items-start mb-1">
                <span class="font-semibold">${event.title}</span>
                <span class="text-xs text-slate-400">${event.time}</span>
              </div>
              <p class="text-slate-300 text-xs">${event.description}</p>
            </div>
          `).join('');
        }
      }
      
      // Update tactical map
      updateTacticalMap(state, mapConfig);
      
      // Update media feeds - dispatch custom event for React component
      if (state.media_feeds) {
        window.dispatchEvent(new CustomEvent('media-feeds-update', {
          detail: { mediaFeeds: state.media_feeds }
        }));
      }
      
      // Update Mission Escalation Banner and Recommended Actions
      if (state.mission_escalation) {
        const escalation = state.mission_escalation;
        
        // Update Contact Continuity Risk in Network Status
        const contactRiskEl = document.getElementById('contact-continuity-risk');
        if (contactRiskEl) {
          const riskClasses = {
            'stable': 'bg-green-900/40 text-green-300 border border-green-700',
            'watch': 'bg-yellow-900/40 text-yellow-300 border border-yellow-700',
            'high': 'bg-orange-900/40 text-orange-300 border border-orange-700',
            'critical': 'bg-red-900/40 text-red-300 border border-red-700'
          };
          contactRiskEl.className = `font-semibold px-2 py-1 rounded text-sm ${riskClasses[escalation.contact_continuity_risk] || riskClasses.stable}`;
          contactRiskEl.textContent = escalation.contact_continuity_risk.toUpperCase();
        }
        
        // Render Escalation Banner
        const bannerContainer = document.getElementById('escalation-banner-container');
        if (bannerContainer && escalation.active) {
          const severityClasses = {
            'critical': { container: 'bg-red-900/40 border-red-500', icon: 'text-red-400', title: 'text-red-200', text: 'text-red-100' },
            'urgent': { container: 'bg-orange-900/40 border-orange-500', icon: 'text-orange-400', title: 'text-orange-200', text: 'text-orange-100' },
            'warning': { container: 'bg-yellow-900/40 border-yellow-500', icon: 'text-yellow-400', title: 'text-yellow-200', text: 'text-yellow-100' },
            'advisory': { container: 'bg-blue-900/40 border-blue-500', icon: 'text-blue-400', title: 'text-blue-200', text: 'text-blue-100' }
          };
          const classes = severityClasses[escalation.severity] || severityClasses.advisory;
          const shouldPulse = escalation.severity === 'critical' || escalation.severity === 'urgent';
          
          const riskBadgeClasses = {
            'critical': 'bg-red-900/60 border-red-600 text-red-200',
            'high': 'bg-orange-900/60 border-orange-600 text-orange-200',
            'watch': 'bg-yellow-900/60 border-yellow-600 text-yellow-200'
          };
          
          bannerContainer.innerHTML = `
            <div class="rounded-lg border-2 p-4 mb-6 ${classes.container} ${shouldPulse ? 'animate-pulse' : ''}" role="alert" aria-live="assertive">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 ${classes.icon}">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <div class="flex-grow">
                  <div class="flex items-center gap-2 mb-2">
                    <h3 class="text-lg font-bold ${classes.title}">
                      ${escalation.severity.toUpperCase()}: Mission Escalation
                    </h3>
                    ${escalation.contact_continuity_risk && escalation.contact_continuity_risk !== 'stable' 
                      ? `<span class="text-xs px-2 py-1 rounded border ${riskBadgeClasses[escalation.contact_continuity_risk]}">
                           Contact Risk: ${escalation.contact_continuity_risk.toUpperCase()}
                         </span>`
                      : ''}
                  </div>
                  ${escalation.reason ? `<p class="text-base ${classes.text} leading-relaxed">${escalation.reason}</p>` : ''}
                  ${escalation.area_of_interest 
                    ? `<div class="mt-2 text-sm opacity-90">
                         <span class="font-semibold">Area of Interest:</span> 
                         <span class="font-mono ml-1">${escalation.area_of_interest}</span>
                       </div>`
                    : ''}
                </div>
              </div>
            </div>
          `;
        } else if (bannerContainer) {
          bannerContainer.innerHTML = '';
        }
        
        // Render Recommended Actions
        const actionsContainer = document.getElementById('recommended-actions-container');
        if (actionsContainer && escalation.active && escalation.recommended_actions && escalation.recommended_actions.length > 0) {
          const actionClasses = {
            'critical': { container: 'bg-red-900/20 border-red-700', header: 'bg-red-900/40 border-red-700', title: 'text-red-200', icon: 'text-red-400', item: 'border-red-700/50 hover:bg-red-900/20' },
            'urgent': { container: 'bg-orange-900/20 border-orange-700', header: 'bg-orange-900/40 border-orange-700', title: 'text-orange-200', icon: 'text-orange-400', item: 'border-orange-700/50 hover:bg-orange-900/20' },
            'warning': { container: 'bg-yellow-900/20 border-yellow-700', header: 'bg-yellow-900/40 border-yellow-700', title: 'text-yellow-200', icon: 'text-yellow-400', item: 'border-yellow-700/50 hover:bg-yellow-900/20' },
            'advisory': { container: 'bg-slate-800/50 border-slate-700', header: 'bg-slate-800 border-slate-700', title: 'text-slate-200', icon: 'text-slate-400', item: 'border-slate-700/50 hover:bg-slate-700/30' }
          };
          const aClasses = actionClasses[escalation.severity] || actionClasses.advisory;
          
          actionsContainer.innerHTML = `
            <div class="rounded-lg border ${aClasses.container}">
              <div class="px-4 py-3 border-b ${aClasses.header}">
                <h3 class="font-semibold flex items-center gap-2 ${aClasses.title}">
                  <svg class="w-5 h-5 ${aClasses.icon}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                  </svg>
                  Recommended Actions
                </h3>
              </div>
              <div class="p-4">
                <ul class="space-y-2">
                  ${escalation.recommended_actions.map((action, index) => `
                    <li class="flex items-start gap-3 p-3 rounded border ${aClasses.item} transition-colors">
                      <div class="flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${
                        escalation.severity === 'critical' || escalation.severity === 'urgent' 
                          ? 'bg-red-700 text-red-100' 
                          : escalation.severity === 'warning'
                          ? 'bg-yellow-700 text-yellow-100'
                          : 'bg-slate-700 text-slate-200'
                      }">
                        ${index + 1}
                      </div>
                      <div class="flex-grow text-sm text-slate-200 leading-relaxed pt-0.5">
                        ${action}
                      </div>
                      ${index === 0 && (escalation.severity === 'critical' || escalation.severity === 'urgent') 
                        ? '<div class="flex-shrink-0"><span class="text-xs px-2 py-1 rounded bg-red-700 text-red-100 font-semibold">PRIORITY</span></div>'
                        : ''}
                    </li>
                  `).join('')}
                </ul>
              </div>
            </div>
          `;
        } else if (actionsContainer) {
          actionsContainer.innerHTML = '';
        }
      }
      
      // Update debug panel
      const debugEl = document.getElementById('debug-json');
      if (debugEl) {
        debugEl.textContent = JSON.stringify(state, null, 2);
      }
    } catch (error) {
      console.error('Error in poll override:', error);
    }
  };
  
  console.log('Cave rescue simulation manager initialized');
</script>
</BaseLayout>
