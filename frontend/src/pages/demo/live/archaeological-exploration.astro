---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SimulationControls from '../../../components/demo/SimulationControls.astro';
import TacticalMap from '../../../components/demo/TacticalMap.astro';
import DataSourceBadge from '../../../components/demo/DataSourceBadge.astro';
import MediaFeedsPanel from '../../../components/islands/MediaFeedsPanel';
import RouteProfile from '../../../components/demo/RouteProfile.astro';

const MISSION_PK = '2b4d7f1e-6c9a-4e3b-8f5d-1c7a3e9b2d6f';
const USE_CASE = 'archaeological-exploration';
const TITLE = 'Archaeological Exploration';

const initialClock = {
  started_at: null,
  elapsed_seconds: 0,
  speed_multiplier: 1.0,
  is_running: false,
};
---

<BaseLayout 
  title={`Live Simulation - ${TITLE}`}
  description="Real-time heritage site exploration simulation with Django API"
>
  <div class="min-h-screen bg-slate-900 text-slate-100 py-8 px-4 sm:px-6 lg:px-8" data-mission-pk={MISSION_PK}>
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <a href="/demo" class="text-rescue-400 hover:text-rescue-300 text-sm mb-4 inline-block">
          ← Back to Demo Overview
        </a>
        <div class="flex items-start justify-between flex-wrap gap-4">
          <div>
            <h1 class="text-4xl font-bold mb-2">Live Simulation: {TITLE}</h1>
            <p class="text-slate-400">Non-destructive heritage site mapping and documentation</p>
            <a href="/demo/archaeological-exploration" class="text-xs text-slate-500 hover:text-slate-400 mt-1 inline-block">
              View static profile →
            </a>
          </div>
          <DataSourceBadge source="django" />
        </div>
      </div>

      <!-- Use Case Navigation -->
      <div class="mb-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-sm font-semibold mb-2">Switch Use Case:</div>
        <div class="flex flex-wrap gap-2">
          <a href="/demo/live/collapsed-building-search" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors">
            Collapsed Building
          </a>
          <a href="/demo/live/cave-rescue" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors">
            Cave Rescue
          </a>
          <a href="/demo/live/flooded-structure" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors">
            Flooded Structure
          </a>
          <a href="/demo/live/industrial-inspection" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm transition-colors">
            Industrial Inspection
          </a>
          <a href="/demo/live/archaeological-exploration" class="px-4 py-2 bg-rescue-600 rounded text-sm font-semibold">
            Archaeological Exploration
          </a>
        </div>
      </div>

      <!-- Simulation Controls -->
      <div class="mb-8">
        <SimulationControls clock={initialClock} missionPk={MISSION_PK} />
      </div>

      <!-- Tactical Map -->
      <div class="mb-8">
        <TacticalMap useCase={USE_CASE} />
      </div>

      <!-- Route Profile -->
      <div id="route-profile-container" class="mb-8">
        <RouteProfile containerId="route-profile" title="Route Profile — Chamber Depths" />
      </div>

      <!-- Dashboard Grid -->
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Agent Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Agent Status</h2>
          <div id="agents-container" class="space-y-4">
            <p class="text-slate-400">Loading agents...</p>
          </div>
        </div>

        <!-- Environmental Status Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Environmental Monitoring</h2>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-slate-400">Temperature:</span>
              <span id="temperature-reading" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Humidity:</span>
              <span id="humidity-reading" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">O₂ Level:</span>
              <span id="o2-reading" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">CO₂ Level:</span>
              <span id="co2-reading" class="font-semibold">--</span>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-700">
            <h3 class="text-lg font-semibold mb-3">Network Status</h3>
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-slate-400">Mesh Health:</span>
                <span id="mesh-health" class="font-semibold">--</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Packet Loss:</span>
                <span id="packet-loss" class="font-semibold">--</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Map Coverage Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Chamber Mapping</h2>
          <div class="space-y-3 mb-4">
            <div class="flex justify-between">
              <div class="flex items-center gap-1.5 group relative">
                <span class="text-slate-400">Sectors Mapped:</span>
                <svg class="w-4 h-4 text-slate-500 cursor-help" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-slate-900 border border-slate-600 rounded-lg text-xs text-slate-300 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 shadow-xl">
                  <p class="font-semibold text-slate-100 mb-1">Sectors Mapped</p>
                  <p>Percentage of terrain sectors that have been explored by agents. Shows mission progress toward complete coverage.</p>
                </div>
              </div>
              <span id="map-coverage" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <div class="flex items-center gap-1.5 group relative">
                <span class="text-slate-400">Confidence:</span>
                <svg class="w-4 h-4 text-slate-500 cursor-help" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-slate-900 border border-slate-600 rounded-lg text-xs text-slate-300 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 shadow-xl">
                  <p class="font-semibold text-slate-100 mb-1">SLAM Confidence</p>
                  <p>Reliability of the Simultaneous Localization and Mapping system. Can degrade due to dust, feature-poor passages, or accumulated positioning error.</p>
                </div>
              </div>
              <span id="map-confidence" class="font-semibold">--</span>
            </div>
            <div class="flex justify-between">
              <div class="flex items-center gap-1.5 group relative">
                <span class="text-slate-400">Points Captured:</span>
                <svg class="w-4 h-4 text-slate-500 cursor-help" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="absolute left-0 bottom-full mb-2 w-64 p-3 bg-slate-900 border border-slate-600 rounded-lg text-xs text-slate-300 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 shadow-xl">
                  <p class="font-semibold text-slate-100 mb-1">Total Points</p>
                  <p>Approximate LiDAR point cloud density captured during mapping (~1,000 points per explored sector). Represents the 3D measurement data collected.</p>
                </div>
              </div>
              <span id="map-points" class="font-semibold">--</span>
            </div>
          </div>
          <div class="mt-4">
            <h3 class="text-sm font-semibold mb-2 text-slate-300">Discovered Chambers:</h3>
            <div id="discovered-chambers" class="text-sm text-slate-400">
              <p>Waiting for first chamber discovery...</p>
            </div>
          </div>
        </div>

        <!-- Artefact Candidates Panel -->
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Artefact Candidates</h2>
          <p class="text-xs text-slate-400 mb-4">Review only - not definitive identification</p>
          <div id="artefact-candidates" class="space-y-3">
            <p class="text-slate-400">No candidates detected yet...</p>
          </div>
        </div>
      </div>

      <!-- Media Feeds Panel -->
      <div class="mt-6">
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Live Media Feeds</h2>
          <MediaFeedsPanel client:load />
        </div>
      </div>

      <!-- Mission Events Timeline -->
      <div class="mt-6">
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">Mission Events</h2>
          <div id="events-container" class="space-y-3">
            <p class="text-slate-400">No events yet...</p>
          </div>
        </div>
      </div>

      <!-- AI Analysis Panel -->
      <div class="mt-6">
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h2 class="text-2xl font-bold mb-4">AI Analyst</h2>
          <div id="ai-analysis-container">
            <p class="text-slate-300 mb-4" id="ai-summary">Preparing analysis...</p>
            <div id="ai-findings" class="space-y-2"></div>
          </div>
        </div>
      </div>

      <!-- Debug Panel (collapsed by default) -->
      <div class="mt-6">
        <details class="bg-slate-800 rounded-lg border border-slate-700">
          <summary class="p-4 cursor-pointer hover:bg-slate-750 font-semibold">Debug: Full State JSON</summary>
          <div class="p-4 border-t border-slate-700">
            <pre id="debug-json" class="text-xs bg-slate-900 p-4 rounded overflow-auto max-h-96 text-slate-300">Loading...</pre>
          </div>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { formatCompactMissionTime, initializeSimulation } from '../../../lib/simulation-manager';
  import { initializeTacticalMapWithDigitalTwin, updateTacticalMap } from '../../../lib/tactical-map-manager';
  import { updateDetectionData } from '../../../lib/detection-modal-manager';
  import { renderInteractiveActions } from '../../../lib/recommended-actions-manager';
  import { initializeRouteProfile, updateRouteProfile } from '../../../lib/route-profile-renderer';
  import { adaptToRouteProfile } from '../../../lib/tactical-map/routeProfileAdapter';
  import { getTerrainSectors, getTerrainPaths, getWaypoints } from '../../../lib/api';
  import { getTerrainBinding } from '../../../lib/tactical-map/useCaseTerrainBindings';
  import { createPanZoomController } from '../../../lib/tactical-map-pan-zoom';
  
  const MISSION_PK = document.querySelector('[data-mission-pk]')?.getAttribute('data-mission-pk') || '';
  const manager = initializeSimulation(MISSION_PK);
  
  // Initialize tactical map with Digital Twin terrain (async)
  let mapConfig: any;
  let panZoomController: any;
  (async () => {
    mapConfig = await initializeTacticalMapWithDigitalTwin('archaeological-exploration');
    
    // Enable pan/zoom controls
    const svgElement = document.getElementById('tactical-map-svg') as SVGSVGElement;
    if (svgElement) {
      panZoomController = createPanZoomController(svgElement, 'map-content', {
        minScale: 0.5,
        maxScale: 5,
        zoomSpeed: 0.15,
      });
      panZoomController.enable();
      
      // Wire up UI controls
      document.getElementById('map-zoom-in')?.addEventListener('click', () => {
        const state = panZoomController.getState();
        panZoomController.setState({ scale: state.scale * 1.3 });
      });
      
      document.getElementById('map-zoom-out')?.addEventListener('click', () => {
        const state = panZoomController.getState();
        panZoomController.setState({ scale: state.scale / 1.3 });
      });
      
      document.getElementById('map-reset-view')?.addEventListener('click', () => {
        panZoomController.reset();
      });
    }
    
    // Initialize route profile with Digital Twin data
    try {
      const binding = getTerrainBinding('archaeological-exploration');
      if (binding && binding.terrainMapSlug) {
        const [sectorsResult, pathsResult, waypointsResult] = await Promise.all([
          getTerrainSectors(binding.terrainMapSlug),
          getTerrainPaths(binding.terrainMapSlug),
          getWaypoints(binding.terrainMapSlug)
        ]);
        
        if (sectorsResult.success && sectorsResult.data) {
          // Handle paginated response from Django REST Framework
          const sectors = Array.isArray(sectorsResult.data) ? sectorsResult.data : (sectorsResult.data as any).results || [];
          const paths = pathsResult.success ? (Array.isArray(pathsResult.data) ? pathsResult.data : (pathsResult.data as any).results || []) : [];
          const waypoints = waypointsResult.success ? (Array.isArray(waypointsResult.data) ? waypointsResult.data : (waypointsResult.data as any).results || []) : [];
          
          const routeProfileViewModel = adaptToRouteProfile(
            sectors,
            paths,
            waypoints,
            undefined,
            'Surface Entry'
          );
          initializeRouteProfile(routeProfileViewModel, { containerId: 'route-profile' });
        }
      }
    } catch (err) {
      console.error('Route profile initialization failed:', err);
      const loadingEl = document.getElementById('route-profile-loading');
      if (loadingEl) loadingEl.textContent = 'Failed to load route profile';
    }
  })(); // End async IIFE
  
  // Enhanced UI update for archaeological exploration
  const originalPoll = (manager as any).poll;
  (manager as any).poll = async function() {
    try {
      await originalPoll.call(this);
      
      const state = this.getLastState();
      if (!state) return;
      
      // Update mission clock
      const clockEl = document.getElementById('mission-clock-time');
      if (clockEl && state.simulation_clock) {
        clockEl.textContent = formatCompactMissionTime(state.simulation_clock.elapsed_seconds);
      }
      
      // Update agents display
      const agentsContainer = document.getElementById('agents-container');
      if (agentsContainer && state.agents) {
        agentsContainer.innerHTML = state.agents.map(agent => `
          <div class="p-4 bg-slate-700 rounded-lg">
            <div class="flex justify-between items-start mb-2">
              <div>
                <h3 class="font-semibold">${agent.name}</h3>
                <p class="text-xs text-slate-400">${agent.role}</p>
              </div>
              <span data-agent-state="${agent.agent_id}" class="px-2 py-1 rounded text-xs font-semibold bg-slate-800 text-slate-300">
                ${agent.state}
              </span>
            </div>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Battery:</span>
                <span data-agent-battery="${agent.agent_id}">${agent.battery_percent}%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Signal:</span>
                <span data-agent-signal="${agent.agent_id}">${agent.signal_strength}%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Location:</span>
                <span class="text-xs">${agent.location_label}</span>
              </div>
              ${agent.nfc_recovery_available ? '<div class="text-xs text-yellow-400 mt-2 flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg> NFC recovery available</div>' : ''}
            </div>
            <div class="mt-2 h-2 bg-slate-900 rounded-full overflow-hidden">
              <div 
                data-agent-battery-bar="${agent.agent_id}"
                class="h-full bg-green-500 transition-all duration-500"
                style="width: ${agent.battery_percent}%"
              ></div>
            </div>
          </div>
        `).join('');
      }
      
      // Update environmental readings
      if (state.sensors && state.sensors.environmental_readings) {
        const readings = state.sensors.environmental_readings;
        
        const getStatusClass = (status: string) => {
          switch (status) {
            case 'normal': return 'text-green-400';
            case 'watch': return 'text-yellow-400';
            case 'warning': return 'text-orange-400';
            case 'critical': return 'text-red-400';
            default: return 'text-slate-300';
          }
        };
        
        const tempReading = readings.find((r: any) => r.sensor_type === 'temperature');
        const tempEl = document.getElementById('temperature-reading');
        if (tempReading && tempEl) {
          tempEl.className = `font-semibold ${getStatusClass(tempReading.status)}`;
          tempEl.textContent = `${tempReading.value}${tempReading.unit}`;
        }
        
        const humidityReading = readings.find((r: any) => r.sensor_type === 'humidity');
        const humidityEl = document.getElementById('humidity-reading');
        if (humidityReading && humidityEl) {
          humidityEl.className = `font-semibold ${getStatusClass(humidityReading.status)}`;
          humidityEl.textContent = `${humidityReading.value}${humidityReading.unit}`;
        }
        
        const o2Reading = readings.find((r: any) => r.sensor_type === 'oxygen');
        const o2El = document.getElementById('o2-reading');
        if (o2Reading && o2El) {
          o2El.className = `font-semibold ${getStatusClass(o2Reading.status)}`;
          o2El.textContent = `${o2Reading.value}${o2Reading.unit}`;
        }
        
        const co2Reading = readings.find((r: any) => r.sensor_type === 'carbon_dioxide');
        const co2El = document.getElementById('co2-reading');
        if (co2Reading && co2El) {
          co2El.className = `font-semibold ${getStatusClass(co2Reading.status)}`;
          co2El.textContent = `${co2Reading.value}${co2Reading.unit}`;
        }
      }
      
      // Update network status
      if (state.network) {
        const meshEl = document.getElementById('mesh-health');
        const lossEl = document.getElementById('packet-loss');
        if (meshEl) meshEl.textContent = `${state.network.mesh_health}%`;
        if (lossEl) lossEl.textContent = `${state.network.packet_loss_percent}%`;
      }
      
      // Update map coverage
      if (state.map) {
        const coverageEl = document.getElementById('map-coverage');
        const confidenceEl = document.getElementById('map-confidence');
        const pointsEl = document.getElementById('map-points');
        
        if (coverageEl) coverageEl.textContent = `${state.map.coverage_percent}%`;
        if (confidenceEl) confidenceEl.textContent = `${(state.map.confidence * 100).toFixed(0)}%`;
        if (pointsEl) pointsEl.textContent = state.map.total_points.toLocaleString();
        
        const chambersEl = document.getElementById('discovered-chambers');
        if (chambersEl && state.map.mapped_sectors && state.map.mapped_sectors.length > 0) {
          chambersEl.innerHTML = state.map.mapped_sectors.map(sector => 
            `<div class="px-2 py-1 bg-slate-700 rounded text-xs inline-block mr-2 mb-2">${sector}</div>`
          ).join('');
        }
      }
      
      // Update artefact candidates
      if (state.sensors && state.sensors.artefact_candidates) {
        const candidatesEl = document.getElementById('artefact-candidates');
        if (candidatesEl) {
          if (state.sensors.artefact_candidates.length === 0) {
            candidatesEl.innerHTML = '<p class="text-slate-400">No candidates detected yet...</p>';
          } else {
            candidatesEl.innerHTML = state.sensors.artefact_candidates.map(candidate => `
              <div class="p-3 bg-slate-700 rounded-lg text-sm">
                <div class="flex justify-between items-start mb-1">
                  <span class="font-semibold text-yellow-400">${candidate.type}</span>
                  <span class="text-xs text-slate-400">${candidate.detected_at}</span>
                </div>
                <p class="text-slate-300 text-xs mb-1">${candidate.location}</p>
                <div class="flex justify-between items-center text-xs">
                  <span class="text-slate-400">Confidence: ${(candidate.confidence * 100).toFixed(0)}%</span>
                  <span class="text-orange-400">${candidate.status}</span>
                </div>
              </div>
            `).join('');
          }
        }
      }
      
      // Update events display
      const eventsContainer = document.getElementById('events-container');
      if (eventsContainer && state.events) {
        if (state.events.length === 0) {
          eventsContainer.innerHTML = '<p class="text-slate-400">No events yet...</p>';
        } else {
          eventsContainer.innerHTML = state.events.slice().reverse().map(event => `
            <div class="p-3 bg-slate-700 rounded-lg text-sm">
              <div class="flex justify-between items-start mb-1">
                <span class="font-semibold">${event.title}</span>
                <span class="text-xs text-slate-400">${event.time}</span>
              </div>
              <p class="text-slate-300 text-xs">${event.description}</p>
            </div>
          `).join('');
        }
      }
      
      // Update tactical map
      updateTacticalMap(state, mapConfig);
      
      // Update route profile
      (async () => {
        try {
          const binding = getTerrainBinding('archaeological-exploration');
          if (binding && binding.terrainMapSlug) {
            const [sectorsResult, pathsResult, waypointsResult] = await Promise.all([
              getTerrainSectors(binding.terrainMapSlug),
              getTerrainPaths(binding.terrainMapSlug),
              getWaypoints(binding.terrainMapSlug)
            ]);
            
            if (sectorsResult.success && sectorsResult.data) {
              // Handle paginated response from Django REST Framework
              const sectors = Array.isArray(sectorsResult.data) ? sectorsResult.data : (sectorsResult.data as any).results || [];
              const paths = pathsResult.success ? (Array.isArray(pathsResult.data) ? pathsResult.data : (pathsResult.data as any).results || []) : [];
              const waypoints = waypointsResult.success ? (Array.isArray(waypointsResult.data) ? waypointsResult.data : (waypointsResult.data as any).results || []) : [];
              
              const routeProfileViewModel = adaptToRouteProfile(
                sectors,
                paths,
                waypoints,
                state,
                'Surface Entry'
              );
              updateRouteProfile(routeProfileViewModel, { containerId: 'route-profile' });
            }
          }
        } catch (err) {
          console.error('Route profile update failed:', err);
        }
      })();
      
      // Update detection data for modal manager
      updateDetectionData(state);
      
      // Update AI analysis
      if (state.ai_analysis) {
        const summaryEl = document.getElementById('ai-summary');
        const findingsEl = document.getElementById('ai-findings');
        
        if (summaryEl) {
          summaryEl.textContent = state.ai_analysis.summary;
        }
        
        if (findingsEl && state.ai_analysis.priority_findings) {
          if (state.ai_analysis.priority_findings.length === 0) {
            findingsEl.innerHTML = '';
          } else {
            findingsEl.innerHTML = `
              <h3 class="text-sm font-semibold mb-2 text-slate-300">Priority Findings:</h3>
              ${state.ai_analysis.priority_findings.map(finding => `
                <div class="p-2 bg-slate-700 rounded text-sm text-slate-300 flex items-start gap-2">
                  <svg class="w-4 h-4 text-rescue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span>${finding}</span>
                </div>
              `).join('')}
            `;
          }
        }
      }
      
      // Update media feeds - dispatch custom event for React component
      if (state.media_feeds) {
        window.dispatchEvent(new CustomEvent('media-feeds-update', {
          detail: { mediaFeeds: state.media_feeds }
        }));
      }
      
      // Update debug panel
      const debugEl = document.getElementById('debug-json');
      if (debugEl) {
        debugEl.textContent = JSON.stringify(state, null, 2);
      }
    } catch (error) {
      console.error('Error in poll override:', error);
    }
  };
  
  console.log('Archaeological exploration simulation manager initialized');
</script>
</BaseLayout>
