---
// Redirect /demo/cave to /demo/cave-rescue
if (Astro.request) {
  return Astro.redirect('/demo/cave-rescue', 301);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0; url=/demo/cave-rescue">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Redirecting...</title>
  <script>
    window.location.href = '/demo/cave-rescue';
  </script>
</head>
<body>
  <p>Redirecting to <a href="/demo/cave-rescue">Cave Rescue</a>...</p>
</body>
</html>
