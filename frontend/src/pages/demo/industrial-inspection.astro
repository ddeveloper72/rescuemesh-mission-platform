---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoDashboard from '../../components/demo/DemoDashboard.astro';
import { API_ENDPOINTS, fetchAPI } from '../../config/api';
import type { UseCaseDemoProfile } from '../../types/demo';

let profile: UseCaseDemoProfile | null = null;

try {
  profile = await fetchAPI<UseCaseDemoProfile>(
    API_ENDPOINTS.useCases.demoProfile('industrial-inspection')
  );
} catch (error) {
  console.error('Failed to fetch demo profile:', error);
  return Astro.redirect('/404');
}

if (!profile) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`${profile.title} - Demo`} description={profile.missionObjective}>
  <div class="py-8 px-4 sm:px-6 lg:px-8 bg-slate-900">
    <div class="max-w-7xl mx-auto mb-6">
      <a href="/demo" class="text-rescue-400 hover:text-rescue-300 text-sm">← Back to Demo Overview</a>
    </div>
  </div>
  <DemoDashboard profile={profile} />
</BaseLayout>
