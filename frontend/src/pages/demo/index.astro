---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { API_ENDPOINTS, fetchAPI } from '../../lib/api';
import type { UseCaseDemoProfile } from '../../types/demo';
import type { PaginatedResponse, UseCaseListItem } from '../../lib/api';
import { getDemoProfileFallback } from '../../data/demo-profile-fallbacks';

// Fetch all demo profiles from the API
let useCaseDemoProfiles: UseCaseDemoProfile[] = [];

// Fetch the list of use cases
const useCasesResult = await fetchAPI<PaginatedResponse<UseCaseListItem>>(
  API_ENDPOINTS.useCases.list()
);

if (useCasesResult.success && useCasesResult.data) {
  // Fetch demo profiles for each use case
  const profilePromises = useCasesResult.data.results.map(uc => 
    fetchAPI<UseCaseDemoProfile>(API_ENDPOINTS.useCases.demoProfile(uc.slug))
  );
  
  const profileResults = await Promise.all(profilePromises);
  
  // Extract successful profiles
  useCaseDemoProfiles = profileResults
    .filter(result => result.success && result.data)
    .map(result => result.data!);
}

const archaeologicalProfile = getDemoProfileFallback('archaeological-exploration');
if (
  archaeologicalProfile &&
  !useCaseDemoProfiles.some(profile => profile.slug === archaeologicalProfile.slug)
) {
  useCaseDemoProfiles.push(archaeologicalProfile);
}
---

<BaseLayout title="Mission Demos" description="Interactive simulated missions for RescueMesh use cases">
  <div class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <a href="/" class="text-rescue-400 hover:text-rescue-300">← Back to Home</a>
      </div>

      <h1 class="text-4xl font-bold mb-4">Mission Demos</h1>
      <p class="text-xl text-slate-300 mb-12">
        Experience simulated missions for each RescueMesh use case. View static mission profiles
        or run live Django-backed simulations with real-time agent telemetry, sensor events, and AI analysis.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mb-12">
        {useCaseDemoProfiles.map(profile => (
          <div
            class="bg-slate-800 rounded-lg p-6 border border-slate-700"
          >
            <div class="flex items-start justify-between mb-3">
              <h2 class="text-xl font-semibold">{profile.title}</h2>
              <span class="px-2 py-1 bg-blue-900 text-blue-300 rounded text-xs border border-blue-700">
                {profile.status}
              </span>
            </div>
            
            <p class="text-sm text-alert-400 font-semibold mb-3">
              Priority: {profile.priority}
            </p>
            
            <p class="text-slate-300 mb-4 text-sm line-clamp-2">
              {profile.missionObjective}
            </p>
            
            <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
              <div>{profile.agents.length} Agents</div>
              <div>{profile.simulation.missionDurationMinutes} min</div>
              <div>{Math.round(profile.simulation.defaultConfidence * 100)}% confidence</div>
            </div>
            
            <div class="flex flex-wrap gap-2 mb-4">
              {profile.simulation.environmentTags.slice(0, 3).map(tag => (
                <span class="px-2 py-1 bg-slate-700 text-slate-300 rounded text-xs">
                  {tag}
                </span>
              ))}
            </div>
            
            <div class="mb-4">
              <div class="text-xs text-slate-500 mb-2">Risk Level</div>
              <div class="flex gap-2">
                <span class="px-2 py-0.5 bg-alert-900 text-alert-300 rounded text-xs">
                  Comms: {profile.simulation.communicationRisk}
                </span>
              </div>
            </div>

            <!-- Data availability indicators -->
            <div class="flex gap-3 mb-4 text-xs">
              <div class="flex items-center gap-1 text-slate-400">
                <span class="w-2 h-2 bg-slate-500 rounded-full"></span>
                <span>Static profile available</span>
              </div>
              <div class="flex items-center gap-1 text-green-400">
                <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                <span>Live simulation available</span>
              </div>
            </div>

            <!-- Action buttons -->
            <div class="flex gap-3">
              <a 
                href={`/demo/${profile.slug}`}
                class="flex-1 px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white text-center rounded font-semibold transition-colors text-sm"
              >
                View Profile
              </a>
              <a 
                href={`/demo/live/${profile.slug}`}
                class="flex-1 px-4 py-2 bg-rescue-600 hover:bg-rescue-500 text-white text-center rounded font-semibold transition-colors text-sm"
              >
                Run Live Simulation
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
        <h3 class="text-lg font-semibold mb-3">Demo Features</h3>
        <ul class="space-y-2 text-slate-300 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-rescue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Static mission profile views</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-rescue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Live Django-backed simulation pages</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-rescue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Simulated agent battery and signal changes</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-rescue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Mission map coverage and confidence updates</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-rescue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Sensor detections and failure events</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-rescue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>AI analyst summaries and human review prompts</span>
          </li>
        </ul>

        <div class="mt-4 p-4 bg-blue-900 bg-opacity-20 border border-blue-700 rounded">
          <p class="text-sm text-blue-200">
            <strong>Note:</strong> Static profile pages use local TypeScript fallback data.
            Live simulation pages connect to the Django API and show changing mission state, agent telemetry,
            map coverage, sensor events, failure scenarios, and AI analysis.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
