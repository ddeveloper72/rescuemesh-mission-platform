---
// Redirect to new demo overview page
return Astro.redirect('/demo', 301);
---

<DashboardLayout title="Demo Mission" missionId="mission-demo-001">
  <div class="p-6">
    <!-- Mission Header -->
    <div class="mb-6">
      <h1 class="text-3xl font-bold mb-2">Collapsed Building Search - Demo</h1>
      <div class="flex items-center space-x-4 text-sm">
        <span class="px-3 py-1 bg-rescue-800 text-rescue-300 rounded">Status: <strong>Simulated</strong></span>
        <span class="text-slate-400">Mission ID: mission-demo-001</span>
        <span class="text-slate-400">Started: 2026-05-29 12:00:00</span>
      </div>
    </div>

    <!-- Mission Map -->
    <section id="overview" class="mb-8">
      <div class="bg-slate-800 rounded-lg border border-slate-700 p-6">
        <h2 class="text-xl font-semibold mb-4 text-rescue-400">Mission Map</h2>
        <div class="aspect-video bg-slate-900 rounded flex items-center justify-center border border-slate-600">
          <div class="text-center">
            <div class="mb-2 flex justify-center">
              <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
            </div>
            <p class="text-slate-400">Interactive map visualization</p>
            <p class="text-sm text-slate-500">(Will be implemented as React/TypeScript island)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Agents Grid -->
    <section id="agents" class="mb-8">
      <h2 class="text-xl font-semibold mb-4 text-rescue-400">Active Agents</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <!-- Drone A -->
        <div class="bg-slate-800 rounded-lg border border-slate-700 p-4">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold">Drone A - Survey</h3>
            <span class="px-2 py-1 bg-green-900 text-green-300 text-xs rounded">Active</span>
          </div>
          <div class="space-y-2 text-sm text-slate-300">
            <div class="flex justify-between">
              <span>Battery:</span>
              <span class="font-mono text-green-400">78%</span>
            </div>
            <div class="flex justify-between">
              <span>Signal:</span>
              <span class="font-mono text-green-400">Good</span>
            </div>
            <div class="flex justify-between">
              <span>Location:</span>
              <span class="font-mono">Sector B2</span>
            </div>
            <div class="mt-3 text-xs text-slate-400">
              Sensors: LiDAR, Thermal, RGB
            </div>
          </div>
        </div>

        <!-- Drone B -->
        <div class="bg-slate-800 rounded-lg border border-alert-700 p-4">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold">Drone B - Detection</h3>
            <span class="px-2 py-1 bg-yellow-900 text-yellow-300 text-xs rounded">Relay Mode</span>
          </div>
          <div class="space-y-2 text-sm text-slate-300">
            <div class="flex justify-between">
              <span>Battery:</span>
              <span class="font-mono text-yellow-400">24%</span>
            </div>
            <div class="flex justify-between">
              <span>Signal:</span>
              <span class="font-mono text-yellow-400">Fair</span>
            </div>
            <div class="flex justify-between">
              <span>Location:</span>
              <span class="font-mono">Sector A3</span>
            </div>
            <div class="mt-3 text-xs text-alert-400 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              Landed as relay - intermittent comms
            </div>
          </div>
        </div>

        <!-- Drone C -->
        <div class="bg-slate-800 rounded-lg border border-alert-500 p-4">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold">Drone C - Deep Penetration</h3>
            <span class="px-2 py-1 bg-red-900 text-red-300 text-xs rounded">Failed</span>
          </div>
          <div class="space-y-2 text-sm text-slate-300">
            <div class="flex justify-between">
              <span>Battery:</span>
              <span class="font-mono text-red-400">3%</span>
            </div>
            <div class="flex justify-between">
              <span>Signal:</span>
              <span class="font-mono text-red-400">Lost</span>
            </div>
            <div class="flex justify-between">
              <span>Last Location:</span>
              <span class="font-mono">Void-3</span>
            </div>
            <div class="mt-3 text-xs text-alert-400">
              <div class="flex items-center gap-1 mb-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="8"/>
                </svg>
                Priority detection before failure
              </div>
              <div class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/>
                </svg>
                NFC black-box available
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Telemetry Panel -->
    <section id="telemetry" class="mb-8">
      <div class="bg-slate-800 rounded-lg border border-slate-700 p-6">
        <h2 class="text-xl font-semibold mb-4 text-rescue-400">Live Telemetry</h2>
        <div class="h-64 bg-slate-900 rounded flex items-center justify-center border border-slate-600">
          <div class="text-center">
            <p class="text-slate-400">Real-time telemetry visualization</p>
            <p class="text-sm text-slate-500">(Interactive TypeScript component)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Detections -->
    <section id="sensors" class="mb-8">
      <div class="bg-slate-800 rounded-lg border border-slate-700 p-6">
        <h2 class="text-xl font-semibold mb-4 text-rescue-400">Priority Detections</h2>
        <div class="space-y-3">
          <div class="bg-alert-900/30 border border-alert-700 rounded p-4">
            <div class="flex items-start justify-between mb-2">
              <div>
                <h4 class="font-semibold text-alert-300">Thermal Anomaly + Voice-like Audio</h4>
                <p class="text-sm text-slate-400">Location: Void-3, Sector C2</p>
              </div>
              <span class="px-2 py-1 bg-alert-800 text-alert-200 text-xs rounded">Confidence: 68%</span>
            </div>
            <p class="text-sm text-slate-300 mb-2">
              Thermal signature consistent with human presence. Audio analysis detected voice-like pattern 
              11 seconds before Drone C failure.
            </p>
            <p class="text-xs text-alert-400 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              Human review required
            </p>
          </div>

          <div class="bg-slate-900 border border-slate-700 rounded p-4">
            <div class="flex items-start justify-between mb-2">
              <div>
                <h4 class="font-semibold">WiFi Signal Detected</h4>
                <p class="text-sm text-slate-400">Location: Sector B1</p>
              </div>
              <span class="px-2 py-1 bg-slate-700 text-slate-200 text-xs rounded">Confidence: 91%</span>
            </div>
            <p class="text-sm text-slate-300">
              Mobile device WiFi beacon detected. Signal strength suggests device is within 8-12 meters.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- AI Analyst -->
    <section id="ai-analyst" class="mb-8">
      <div class="bg-slate-800 rounded-lg border border-slate-700 p-6">
        <h2 class="text-xl font-semibold mb-4 text-rescue-400">AI Analyst Recommendations</h2>
        <div class="space-y-4">
          <div class="bg-rescue-900/20 border border-rescue-700 rounded p-4">
            <h4 class="font-semibold mb-2">Priority 1: Investigate Void-3</h4>
            <p class="text-sm text-slate-300 mb-3">
              Combined thermal and audio signatures in Void-3 suggest highest survivor probability (68%). 
              Recommend deploying ground robot or human team to investigate.
            </p>
            <p class="text-xs text-slate-400">
              Recommended action: Deploy ground asset with camera and two-way audio
            </p>
          </div>

          <div class="bg-slate-900 border border-slate-700 rounded p-4">
            <h4 class="font-semibold mb-2">Priority 2: Recover Drone C Black-box</h4>
            <p class="text-sm text-slate-300 mb-3">
              Drone C contains priority observation data. NFC black-box module is accessible for field recovery.
            </p>
            <p class="text-xs text-slate-400">
              Recommended action: Recovery technician with NFC reader
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section id="timeline" class="mb-8">
      <div class="bg-slate-800 rounded-lg border border-slate-700 p-6">
        <h2 class="text-xl font-semibold mb-4 text-rescue-400">Mission Timeline</h2>
        <div class="space-y-3 text-sm">
          <div class="flex items-start space-x-3">
            <span class="text-slate-500 font-mono text-xs">12:00:00</span>
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-slate-300">Mission started - 3 drones deployed</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-slate-500 font-mono text-xs">12:03:42</span>
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/>
            </svg>
            <span class="text-slate-300">Drone A: Initial map coverage 35%</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-slate-500 font-mono text-xs">12:08:15</span>
            <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <span class="text-slate-300">Drone B: Signal degradation detected</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-slate-500 font-mono text-xs">12:11:30</span>
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span class="text-slate-300">Drone B: Landed as relay - battery 24%</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-slate-500 font-mono text-xs">12:14:19</span>
            <svg class="w-5 h-5 text-alert-400" fill="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="8"/>
            </svg>
            <span class="text-slate-300">Drone C: Voice-like audio detected</span>
          </div>
          <div class="flex items-start space-x-3">
            <span class="text-slate-500 font-mono text-xs">12:14:30</span>
            <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span class="text-slate-300">Drone C: Battery failure - black-box saved</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission Report -->
    <section id="report">
      <div class="bg-slate-800 rounded-lg border border-slate-700 p-6">
        <h2 class="text-xl font-semibold mb-4 text-rescue-400">Mission Report</h2>
        <div class="space-y-4 text-sm text-slate-300">
          <div class="grid md:grid-cols-3 gap-4">
            <div>
              <p class="text-slate-400 mb-1">Map Coverage</p>
              <p class="text-2xl font-bold text-rescue-400">67%</p>
            </div>
            <div>
              <p class="text-slate-400 mb-1">Priority Detections</p>
              <p class="text-2xl font-bold text-alert-400">2</p>
            </div>
            <div>
              <p class="text-slate-400 mb-1">Assets Deployed</p>
              <p class="text-2xl font-bold">3 drones, 1 relay</p>
            </div>
          </div>
          <div class="pt-4 border-t border-slate-700">
            <button class="bg-rescue-500 hover:bg-rescue-600 text-white px-6 py-2 rounded transition-colors">
              Export Full Report
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>
</DashboardLayout>
