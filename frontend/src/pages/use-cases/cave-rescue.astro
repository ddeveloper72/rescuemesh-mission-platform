---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UseCaseDetail from '../../components/usecases/UseCaseDetail.astro';
import { getUseCaseBySlug } from '../../data/usecases';

const useCase = getUseCaseBySlug('cave-rescue');

if (!useCase) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={useCase.title} description={useCase.missionObjective}>
  <UseCaseDetail useCase={useCase} />
</BaseLayout>
