---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useCaseProfiles } from '../../data/usecases';
---

<BaseLayout title="Use Cases" description="Mission scenarios for the RescueMesh platform">
  <div class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="mb-8">
        <a href="/" class="text-rescue-400 hover:text-rescue-300">← Back to Home</a>
      </div>

      <h1 class="text-4xl font-bold mb-4">Use Cases</h1>
      <p class="text-xl text-slate-300 mb-12">
        RescueMesh is designed for dangerous, GPS-denied, and partially inaccessible environments where traditional methods are too risky or time-consuming.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        {useCaseProfiles.map(useCase => (
          <a href={`/use-cases/${useCase.slug}`} class="bg-slate-800 rounded-lg p-6 border border-slate-700 hover:border-rescue-400 transition-colors group">
            <div class="flex items-start justify-between mb-3">
              <h2 class="text-xl font-semibold group-hover:text-rescue-400">{useCase.title}</h2>
            </div>
            <p class="text-sm text-alert-400 font-semibold mb-3">Priority: {useCase.priority}</p>
            <p class="text-slate-300 mb-4 text-sm line-clamp-3">{useCase.missionObjective}</p>
            <div class="flex items-center justify-between">
              <div class="text-xs text-slate-400">
                {useCase.recommendedAgents.length} Agents • {useCase.expectedOutputs.length} Outputs
              </div>
              <span class="text-rescue-400 text-sm font-medium">View Details →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center bg-gradient-to-r from-rescue-800 to-rescue-900 rounded-lg p-8 border border-rescue-700">
        <h3 class="text-2xl font-bold mb-4">Experience a Mission</h3>
        <p class="text-slate-300 mb-6">Try a simulated collapsed building search with live telemetry and AI analysis</p>
        <a href="/missions/demo" class="inline-block bg-rescue-500 hover:bg-rescue-600 text-white font-semibold px-8 py-3 rounded-lg transition-colors">
          Launch Demo
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
