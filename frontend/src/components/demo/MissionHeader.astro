---
import type { UseCaseDemoProfile } from '../../types/demo';

interface Props {
  profile: UseCaseDemoProfile;
}

const { profile } = Astro.props;

const statusColors = {
  Simulated: 'bg-blue-900 text-blue-300 border-blue-700',
  Planned: 'bg-slate-700 text-slate-300 border-slate-600',
  Active: 'bg-green-900 text-green-300 border-green-700',
  Completed: 'bg-slate-800 text-slate-400 border-slate-700'
};
---

<div class="bg-slate-800 border border-slate-700 rounded-lg p-6 mb-6">
  <div class="flex items-start justify-between mb-4">
    <div>
      <h1 class="text-3xl font-bold mb-2">{profile.title}</h1>
      <p class="text-slate-300">
        Mission ID: <span class="font-mono text-rescue-400">{profile.missionId}</span>
      </p>
    </div>
    <div class={`px-4 py-2 rounded border ${statusColors[profile.status]}`}>
      {profile.status}
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <div>
      <h3 class="text-sm font-semibold text-slate-400 uppercase mb-2">Priority</h3>
      <p class="text-alert-400 font-semibold text-lg">{profile.priority}</p>
    </div>

    <div>
      <h3 class="text-sm font-semibold text-slate-400 uppercase mb-2">Mission Duration</h3>
      <p class="text-slate-200 text-lg">{profile.simulation.missionDurationMinutes} minutes</p>
    </div>

    <div class="md:col-span-2">
      <h3 class="text-sm font-semibold text-slate-400 uppercase mb-2">Mission Objective</h3>
      <p class="text-slate-300">{profile.missionObjective}</p>
    </div>

    <div class="md:col-span-2">
      <h3 class="text-sm font-semibold text-slate-400 uppercase mb-2">Terrain & Environment</h3>
      <div class="grid md:grid-cols-2 gap-4 text-sm text-slate-300">
        <div>
          <span class="text-slate-400">Type:</span> {profile.terrain.type}
        </div>
        <div>
          <span class="text-slate-400">GPS:</span> {profile.terrain.gps}
        </div>
        <div>
          <span class="text-slate-400">Communications:</span> {profile.terrain.communications}
        </div>
        <div>
          <span class="text-slate-400">Lighting:</span> {profile.terrain.lighting}
        </div>
      </div>
      <div class="mt-2">
        <span class="text-slate-400 text-sm">Hazards:</span>
        <div class="flex flex-wrap gap-2 mt-1">
          {profile.terrain.hazards.map(hazard => (
            <span class="px-2 py-1 bg-alert-900 text-alert-300 rounded text-xs border border-alert-700">
              {hazard}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="md:col-span-2">
      <h3 class="text-sm font-semibold text-slate-400 uppercase mb-2">Risk Assessment</h3>
      <div class="grid grid-cols-3 gap-4 text-sm">
        <div class="bg-slate-900 rounded p-3 border border-slate-700">
          <div class="text-slate-400 mb-1">Communications</div>
          <div class="font-semibold text-alert-400 uppercase">{profile.simulation.communicationRisk}</div>
        </div>
        <div class="bg-slate-900 rounded p-3 border border-slate-700">
          <div class="text-slate-400 mb-1">Battery</div>
          <div class="font-semibold text-alert-400 uppercase">{profile.simulation.batteryRisk}</div>
        </div>
        <div class="bg-slate-900 rounded p-3 border border-slate-700">
          <div class="text-slate-400 mb-1">Sensors</div>
          <div class="font-semibold text-alert-400 uppercase">{profile.simulation.sensorRisk}</div>
        </div>
      </div>
    </div>
  </div>
</div>
