---
/**
 * Tactical Map Component
 * 
 * **Core visualization component for live mission state rendering.**
 * 
 * This component provides a lightweight SVG-based tactical map for visualizing:
 * - Terrain sectors with progressive "fog of war" reveal
 * - Agent positions and movement
 * - Network connectivity between agents (relay chains)
 * - Sensor detections (thermal, audio, gas)
 * - Hazards and obstacles
 * - Compass rose for orientation
 * 
 * **Architecture Decision: Pure SVG, No 3D Libraries**
 * 
 * The MVP uses plain SVG for simplicity and performance:
 * - No Three.js, no CesiumJS, no heavy 3D engines
 * - Fast rendering, small bundle size, easy to debug
 * - Sufficient for 2D/2.5D tactical displays
 * - Future: could upgrade to 3D point cloud visualization
 * 
 * **Use-Case Specific Configuration:**
 * 
 * Each mission type (collapsed-building, cave-rescue, flooded-structure, etc.)
 * has a corresponding map configuration defined in `tactical-map-manager.ts`:
 * - Sector layouts (positions, dimensions, labels)
 * - Terrain colors and styling
 * - Coordinate scaling for digital twin mode
 * - Detection marker positions
 * 
 * **Pan/Zoom Functionality:**
 * 
 * Interactive map navigation via `tactical-map-pan-zoom.ts`:
 * - Drag to pan (survives DOM updates during polling)
 * - Mouse wheel to zoom
 * - Zoom in/out buttons
 * - Reset view button
 * - Transform applied to `#map-content` group, not root SVG
 * 
 * **Rendering Pipeline:**
 * 
 * 1. SVG structure created at page load (static groups)
 * 2. JavaScript polls `/api/v1/missions/{pk}/state/` every 2 seconds
 * 3. `updateTacticalMap(state, config)` called with new data
 * 4. Rendering functions update SVG groups:
 *    - renderSectors() → #map-sectors
 *    - renderNetworkConnections() → #map-network
 *    - renderHazards() → #map-hazards
 *    - renderDetectionMarkers() → #map-detections
 *    - renderAgents() → #map-agents
 *    - renderLabels() → #map-labels (smart collision avoidance)
 *    - renderCompassRose() → #map-compass (fixed viewport position)
 * 
 * **Layer Organization:**
 * 
 * Pannable content (inside #map-content):
 * - Sectors (background)
 * - Network connections
 * - Hazards
 * - Detections
 * - Agents
 * - Labels
 * 
 * Fixed viewport content (outside #map-content):
 * - Compass rose (always visible at top-right)
 * - Pan/zoom controls (buttons)
 * - Map instructions overlay
 * 
 * **Props:**
 * - useCase: Mission type identifier (e.g., 'collapsed-building-search')
 * - title: Optional custom map title (default: "Tactical Map")
 * 
 * **Dependencies:**
 * - tactical-map-manager.ts: Rendering engine
 * - tactical-map-pan-zoom.ts: Pan/zoom controller
 * - Django API: Mission state data source
 * 
 * **Accessibility:**
 * - Semantic SVG structure
 * - ARIA labels on interactive controls
 * - Keyboard-accessible zoom buttons
 * - Clear visual instructions for mouse/wheel interaction
 */

interface Props {
  useCase: string;   // Mission type identifier
  title?: string;    // Custom map title (optional)
}

const { useCase, title = "Tactical Map" } = Astro.props;
---

<div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
  <div class="flex items-center justify-between mb-2">
    <h2 class="text-2xl font-bold">{title}</h2>
    <div id="mission-clock-display" class="text-lg font-mono text-blue-400 bg-slate-900 px-3 py-1 rounded border border-slate-700">
      <span id="mission-clock-time">00:00</span>
    </div>
  </div>
  <p class="text-xs text-slate-400 mb-4">
    <span class="inline-block mr-4">● Terrain generated from simulated LiDAR/depth/sonar returns</span>
    <span class="inline-block mr-4">● Sectors progressively reveal as agents map them</span>
    <span class="inline-block">● Confidence increases with repeated or multi-agent scans</span>
  </p>
  
  <div id="tactical-map-container" class="relative bg-slate-900 rounded-lg overflow-hidden" style="aspect-ratio: 16/9">
    <!-- SVG tactical map will be rendered here by JavaScript -->
    <svg 
      id="tactical-map-svg"
      class="w-full h-full"
      viewBox="0 0 800 450"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Background grid -->
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(148, 163, 184, 0.1)" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
      
      <!-- Transformable content group for pan/zoom -->
      <g id="map-content">
        <!-- Use-case specific map layout will be rendered here -->
        <g id="map-sectors"></g>
        <g id="map-network"></g>
        <g id="map-hazards"></g>
        <g id="map-detections"></g>
        <g id="map-agents"></g>
        <g id="map-labels"></g>
      </g>
      
      <!-- Fixed viewport elements (not affected by pan/zoom) -->
      <g id="map-compass"></g>
    </svg>
    
    <!-- Pan/Zoom Controls -->
    <div class="absolute top-2 right-2 flex flex-col gap-1">
      <button 
        id="map-zoom-in"
        class="w-8 h-8 bg-slate-800 hover:bg-slate-700 rounded border border-slate-600 flex items-center justify-center text-white transition-colors"
        title="Zoom In"
        aria-label="Zoom in"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </button>
      <button 
        id="map-zoom-out"
        class="w-8 h-8 bg-slate-800 hover:bg-slate-700 rounded border border-slate-600 flex items-center justify-center text-white transition-colors"
        title="Zoom Out"
        aria-label="Zoom out"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
        </svg>
      </button>
      <button 
        id="map-reset-view"
        class="w-8 h-8 bg-slate-800 hover:bg-slate-700 rounded border border-slate-600 flex items-center justify-center text-white transition-colors"
        title="Reset View"
        aria-label="Reset view"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
      </button>
    </div>
    
    <!-- Map Instructions -->
    <div class="absolute top-2 left-2 bg-slate-800 bg-opacity-90 rounded px-2 py-1 text-xs text-slate-300">
      <span class="inline-block mr-2">🖱️ Drag to pan</span>
      <span class="inline-block">🔍 Scroll to zoom</span>
    </div>
    
    <!-- Legend -->
    <div class="absolute bottom-2 left-2 bg-slate-800 bg-opacity-90 rounded p-2 text-xs">
      <div class="font-semibold mb-1">Legend</div>
      <div class="space-y-0.5">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-green-500 rounded-full"></div>
          <span>Active Agent</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
          <span>Degraded</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-red-500 rounded-full"></div>
          <span>Critical/Failed</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-purple-500 rounded-full"></div>
          <span>Relay</span>
        </div>
        <div class="border-t border-slate-700 my-1"></div>
        <div class="text-slate-400 font-semibold text-[10px]">Detections</div>
        <div class="flex items-center gap-2">
          <span class="text-red-500">🔥</span>
          <span>Thermal</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-purple-500">🔊</span>
          <span>Audio</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #tactical-map-svg text {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    fill: #e2e8f0;
  }
  
  .agent-marker {
    transition: all 0.5s ease;
  }
  
  .sector-area {
    transition: opacity 0.5s ease;
  }
</style>
