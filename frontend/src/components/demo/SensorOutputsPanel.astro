---
import type { UseCaseDemoProfile } from '../../types/demo';

interface Props {
  profile: UseCaseDemoProfile;
}

const { profile } = Astro.props;

const outputTypeIcons = {
  '3d-map': 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
  'thermal': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  'audio': 'M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z',
  'environmental': 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
  'device-scan': 'M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0',
  'relay-map': 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01',
  'ai-analysis': 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  'report': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
};
---

<div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
  <h2 class="text-xl font-bold mb-4">Sensor Outputs</h2>
  
  <div class="grid md:grid-cols-2 gap-3">
    {profile.expectedOutputs.map(output => (
      <div class="bg-slate-900 rounded-lg p-4 border border-slate-700">
        <div class="flex items-start gap-3">
          <div class="text-rescue-400 mt-1">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={outputTypeIcons[output.outputType]} />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex items-start justify-between mb-2">
              <h3 class="font-semibold text-slate-200">{output.name}</h3>
              {output.confidenceRequired && (
                <span class="px-2 py-0.5 bg-amber-900 text-amber-300 rounded text-xs border border-amber-700">
                  Review
                </span>
              )}
            </div>
            <p class="text-sm text-slate-400">
              {output.description}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-4 text-xs text-slate-500 italic">
    Data source: Django simulation (sensor data included in mission state)
  </div>
</div>
