---
import type { UseCaseDemoProfile } from '../../types/demo';

interface Props {
  profile: UseCaseDemoProfile;
}

const { profile } = Astro.props;

const mapTypeLabels = {
  'void-map': 'Void Map - Collapsed Structure',
  'cave-map': 'Cave Passage Map - Underground System',
  'flood-map': 'Flood Extent Map - Submerged Zones',
  'industrial-map': 'Industrial Asset Map - Plant Layout'
};

const mapDescriptions = {
  'void-map': 'LiDAR-generated 3D void space reconstruction showing accessible areas, obstructions, and structural hazards',
  'cave-map': 'SLAM-based tunnel network map showing passages, chambers, squeeze points, and relay positions',
  'flood-map': 'Multi-sensor flood zone map showing water depth, dry areas, submerged obstacles, and safe routes',
  'industrial-map': 'Geometric asset map showing tanks, pipes, ducts, machinery, and inspection coverage zones'
};

// Get agents that are still active or in relay mode
const activeAgents = profile.agents.filter(a => 
  a.state === 'healthy' || a.state === 'degraded' || a.state === 'landed_relay'
);

const failedAgents = profile.agents.filter(a => 
  a.state === 'failed' || a.state === 'abandoned' || a.state === 'nfc_readable'
);

const agentSummary = profile.agents.map(agent => ({
  id: agent.id,
  name: agent.name,
  state: agent.state
}));
---

<div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
  <div class="flex items-center justify-between mb-2">
    <div>
      <h2 class="text-2xl font-bold">Tactical Map</h2>
      <p class="text-sm text-slate-400">{mapTypeLabels[profile.simulation.mapType]}</p>
    </div>
    <div class="text-lg font-mono text-blue-400 bg-slate-900 px-3 py-1 rounded border border-slate-700">
      <span>{profile.timeline[0]?.time || '00:00'}</span>
    </div>
  </div>
  <p class="text-xs text-slate-400 mb-4">
    <span class="inline-block mr-4">Terrain generated from simulated mission returns</span>
    <span class="inline-block mr-4">Static profile snapshot</span>
    <span class="inline-block">Open live simulation for progressive reveal</span>
  </p>

  <div
    class="relative bg-slate-900 rounded-lg overflow-hidden aspect-video"
    data-static-demo-map
    data-use-case={profile.slug}
  >
    <script type="application/json" data-static-map-agents-data set:html={JSON.stringify(agentSummary)} />

    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgb(148, 163, 184) 1px, transparent 0); background-size: 20px 20px;"></div>
    </div>

    <svg
      class="relative z-10 w-full h-full"
      viewBox="0 0 800 450"
      role="img"
      aria-label={`${mapTypeLabels[profile.simulation.mapType]} seeded tactical map`}
      data-static-map-svg
    >
      <defs>
        <pattern id={`static-grid-${profile.slug}`} width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(148, 163, 184, 0.08)" stroke-width="1" />
        </pattern>
      </defs>
      <rect width="800" height="450" fill={`url(#static-grid-${profile.slug})`} />
      <g data-static-map-paths></g>
      <g data-static-map-sectors></g>
      <g data-static-map-waypoints></g>
      <g data-static-map-agents></g>
      <g data-static-map-fallback>
        <text x="400" y="205" fill="#38bdf8" text-anchor="middle" font-size="16" font-family="ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace">
          {mapTypeLabels[profile.simulation.mapType]}
        </text>
        <text x="400" y="232" fill="#94a3b8" text-anchor="middle" font-size="12">
          {mapDescriptions[profile.simulation.mapType]}
        </text>
      </g>
    </svg>

    <!-- Static controls mirroring the live map -->
    <div class="absolute top-2 right-2 flex flex-col gap-1">
      <button class="w-8 h-8 bg-slate-800 rounded border border-slate-600 flex items-center justify-center text-slate-500" title="Zoom available in live simulation" aria-label="Zoom unavailable in static profile">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
      </button>
      <button class="w-8 h-8 bg-slate-800 rounded border border-slate-600 flex items-center justify-center text-slate-500" title="Zoom available in live simulation" aria-label="Zoom unavailable in static profile">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
        </svg>
      </button>
    </div>

    <div class="absolute top-2 left-2 bg-slate-800 bg-opacity-90 rounded px-2 py-1 text-xs text-slate-300">
      <span data-static-map-status>Profile snapshot</span>
    </div>

    <!-- Asset markers overlay -->
    <div class="absolute top-4 left-4 space-y-2">
      {activeAgents.map(agent => (
        <div class="flex items-center gap-2 bg-slate-800 bg-opacity-90 px-3 py-1 rounded border border-rescue-500 text-xs">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          <span class="text-slate-200">{agent.name}</span>
        </div>
      ))}
      {failedAgents.map(agent => (
        <div class="flex items-center gap-2 bg-slate-800 bg-opacity-90 px-3 py-1 rounded border border-alert-500 text-xs">
          <span class="w-2 h-2 bg-alert-400 rounded-full"></span>
          <span class="text-slate-200">{agent.name}</span>
          {agent.nfcRecoveryAvailable && (
            <span class="text-alert-300">(NFC)</span>
          )}
        </div>
      ))}
    </div>

    <!-- Coverage indicator -->
    <div class="absolute bottom-4 right-4 bg-slate-800 bg-opacity-90 px-4 py-2 rounded border border-slate-700">
      <div class="text-xs text-slate-400 mb-1">Map Coverage</div>
      <div class="text-sm font-semibold text-rescue-400" data-static-map-coverage>
        {Math.round(profile.simulation.defaultConfidence * 100)}%
      </div>
    </div>

    <div class="absolute top-2 left-36 max-w-sm bg-slate-800 bg-opacity-90 rounded px-2 py-1 text-xs text-slate-400 truncate border border-slate-700">
      Source: <span class="text-slate-200" data-static-map-source>Demo profile</span>
    </div>

    <!-- Environment tags -->
    <div class="absolute bottom-4 left-4 flex gap-2">
      {profile.simulation.environmentTags.slice(0, 3).map(tag => (
        <span class="px-2 py-1 bg-slate-800 bg-opacity-90 text-slate-300 rounded text-xs border border-slate-700">
          {tag}
        </span>
      ))}
    </div>
  </div>
</div>

<script>
  import { initialiseStaticDemoMaps } from '../../lib/static-demo-tactical-map';

  initialiseStaticDemoMaps();
</script>
