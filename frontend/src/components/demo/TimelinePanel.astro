---
import type { UseCaseDemoProfile } from '../../types/demo';

interface Props {
  profile: UseCaseDemoProfile;
}

const { profile } = Astro.props;

const eventTypeConfig = {
  'mission-start': { icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z', color: 'text-blue-400', bg: 'bg-blue-900' },
  'mapping': { icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7', color: 'text-rescue-400', bg: 'bg-rescue-900' },
  'relay': { icon: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01', color: 'text-blue-400', bg: 'bg-blue-900' },
  'sensor-detection': { icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z', color: 'text-green-400', bg: 'bg-green-900' },
  'failure': { icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z', color: 'text-alert-400', bg: 'bg-alert-900' },
  'ai-analysis': { icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z', color: 'text-purple-400', bg: 'bg-purple-900' },
  'operator-review': { icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z', color: 'text-cyan-400', bg: 'bg-cyan-900' },
  'mission-end': { icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', color: 'text-green-400', bg: 'bg-green-900' }
};
---

<div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
  <h2 class="text-xl font-bold mb-4">Mission Timeline</h2>
  
  <div class="relative">
    <!-- Timeline line -->
    <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-slate-700"></div>
    
    <!-- Timeline events -->
    <div class="space-y-4">
      {profile.timeline.map((event, index) => {
        const config = eventTypeConfig[event.type || 'mission-start'];
        
        return (
          <div class="relative pl-14">
            <!-- Timeline marker -->
            <div class={`absolute left-3 top-1 w-6 h-6 rounded-full ${config.bg} border-2 border-slate-800 flex items-center justify-center`}>
              <svg class={`w-4 h-4 ${config.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={config.icon} />
              </svg>
            </div>
            
            <!-- Event content -->
            <div class="bg-slate-900 rounded-lg p-3 border border-slate-700">
              <div class="flex items-start justify-between mb-1">
                <div>
                  <span class="text-xs font-mono text-slate-400">{event.time}</span>
                  <h3 class="font-semibold text-slate-200">{event.title}</h3>
                </div>
                {event.confidence !== undefined && (
                  <span class="px-2 py-0.5 bg-rescue-900 text-rescue-300 rounded text-xs border border-rescue-700">
                    {Math.round(event.confidence * 100)}%
                  </span>
                )}
              </div>
              <p class="text-sm text-slate-400">{event.description}</p>
              {event.assetId && (
                <div class="mt-2 text-xs text-slate-500">
                  Asset: <span class="font-mono">{event.assetId}</span>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <div class="mt-4 text-xs text-slate-500 italic">
    TODO: Replace with live event stream from Django API endpoint /api/v1/missions/[id]/timeline
  </div>
</div>
