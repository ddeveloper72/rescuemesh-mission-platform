---
import type { UseCaseDemoProfile } from '../../types/demo';
import MissionMapPanel from './MissionMapPanel.astro';
import AgentStatusPanel from './AgentStatusPanel.astro';
import TelemetryPanel from './TelemetryPanel.astro';
import SensorOutputsPanel from './SensorOutputsPanel.astro';
import TimelinePanel from './TimelinePanel.astro';
import AiAnalystPanel from './AiAnalystPanel.astro';
import MissionReportPanel from './MissionReportPanel.astro';
import DataSourceBadge from './DataSourceBadge.astro';

interface Props {
  profile: UseCaseDemoProfile;
  source?: 'django' | 'fallback';
}

const { profile, source = 'fallback' } = Astro.props;

const demoSlug = profile.slug;

const useCaseLinks = [
  { slug: 'collapsed-building-search', label: 'Collapsed Building' },
  { slug: 'cave-rescue', label: 'Cave Rescue' },
  { slug: 'flooded-structure', label: 'Flooded Structure' },
  { slug: 'industrial-inspection', label: 'Industrial Inspection' },
  { slug: 'archaeological-exploration', label: 'Archaeological Exploration' }
];

const routeProfileTitle = {
  'collapsed-building-search': 'Route Profile - Void Access',
  'cave-rescue': 'Route Profile - Cave Depth',
  'flooded-structure': 'Route Profile - Waterline',
  'industrial-inspection': 'Route Profile - Platform Levels',
  'archaeological-exploration': 'Route Profile - Chamber Depths'
}[demoSlug] || 'Route Profile';

const statusColors = {
  Simulated: 'bg-blue-900 text-blue-300 border-blue-700',
  Planned: 'bg-slate-700 text-slate-300 border-slate-600',
  Active: 'bg-green-900 text-green-300 border-green-700',
  Completed: 'bg-slate-800 text-slate-400 border-slate-700'
};
---

<div class="min-h-screen bg-slate-900 text-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <a href="/demo" class="text-rescue-400 hover:text-rescue-300 text-sm mb-4 inline-block">
        &larr; Back to Demo Overview
      </a>
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <h1 class="text-4xl font-bold mb-2">Mission Profile: {profile.title}</h1>
          <p class="text-slate-400 max-w-3xl">{profile.missionObjective}</p>
          <a href={`/demo/live/${demoSlug}`} class="text-xs text-slate-500 hover:text-slate-400 mt-2 inline-block">
            Open live simulation &rarr;
          </a>
        </div>
        <DataSourceBadge source={source} />
      </div>
    </div>

    <!-- Use Case Navigation -->
    <div class="mb-6 bg-slate-800 rounded-lg p-4 border border-slate-700">
      <div class="text-sm font-semibold mb-2">Switch Use Case:</div>
      <div class="flex flex-wrap gap-2">
        {useCaseLinks.map(link => (
          <a
            href={`/demo/${link.slug}`}
            class={`px-4 py-2 rounded text-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-400 ${
              link.slug === demoSlug
                ? 'bg-rescue-600 font-semibold'
                : 'bg-slate-700 hover:bg-slate-600'
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Profile Mode Controls -->
    <div class="mb-8 bg-slate-800 rounded-lg p-4 border border-slate-700">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="text-xs uppercase tracking-wide text-slate-500 mb-1">Profile Mode</div>
          <div class="text-sm text-slate-300">
            Static mission profile generated from demo data. Live telemetry is available in simulation mode.
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <span class={`px-3 py-1 rounded border text-sm ${statusColors[profile.status]}`}>{profile.status}</span>
          <span class="px-3 py-1 rounded bg-slate-900 border border-slate-700 text-sm text-slate-300">
            {profile.simulation.missionDurationMinutes} min profile
          </span>
          <a
            href={`/demo/live/${demoSlug}`}
            class="px-4 py-2 bg-rescue-600 hover:bg-rescue-500 text-white rounded text-sm font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rescue-300"
          >
            Run Live Simulation
          </a>
        </div>
      </div>
    </div>

    <!-- Tactical Map -->
    <div class="mb-8">
      <MissionMapPanel profile={profile} />
    </div>

    <!-- Route Profile -->
    <div class="mb-8 bg-slate-800 rounded-lg border border-slate-700 p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base font-semibold text-slate-200">{routeProfileTitle}</h2>
        <div class="text-xs px-2 py-1 rounded bg-slate-700 text-slate-300">Profile Snapshot</div>
      </div>
      <div class="mb-3 p-2 bg-slate-900 rounded text-xs text-slate-300 border border-slate-700">
        <div class="flex flex-wrap gap-3">
          <div><span class="text-slate-500">Mission:</span> <span class="text-blue-400 ml-1">{profile.missionId}</span></div>
          <div><span class="text-slate-500">Confidence:</span> <span class="text-rescue-400 ml-1">{Math.round(profile.simulation.defaultConfidence * 100)}%</span></div>
          <div><span class="text-slate-500">Contact:</span> <span class="text-alert-400 ml-1">{profile.simulation.communicationRisk}</span></div>
          <div><span class="text-slate-500">Battery:</span> <span class="text-alert-400 ml-1">{profile.simulation.batteryRisk}</span></div>
        </div>
      </div>
      <div class="bg-slate-900 rounded overflow-hidden">
        <svg width="100%" height="280" viewBox="0 0 800 280" role="img" aria-label={`${profile.title} route profile snapshot`}>
          <line x1="60" y1="240" x2="760" y2="240" stroke="#475569" stroke-width="1" />
          <line x1="60" y1="20" x2="60" y2="240" stroke="#475569" stroke-width="1" />
          <text x="410" y="270" fill="#94a3b8" text-anchor="middle" font-size="11">Route Distance</text>
          <text x="30" y="15" fill="#94a3b8" text-anchor="middle" font-size="11" transform="rotate(-90, 30, 140)">Elevation / Depth</text>
          <path d="M80 190 C190 180, 245 110, 340 125 S510 205, 610 120 S710 80, 750 95" fill="none" stroke="#3b82f6" stroke-width="3" stroke-opacity="0.75" />
          <path d="M80 205 C190 195, 245 125, 340 140 S510 220, 610 135 S710 95, 750 110" fill="none" stroke="#0f172a" stroke-width="20" stroke-opacity="0.55" />
          {profile.timeline.slice(0, 6).map((event, index) => {
            const x = 90 + index * 120;
            const y = 190 - ((index % 3) * 38) + (index > 3 ? 20 : 0);
            return (
              <g>
                <circle cx={x} cy={y} r="8" fill={event.eventType === 'failure' ? '#ef4444' : event.eventType === 'sensor-detection' ? '#f59e0b' : '#10b981'} stroke="#0f172a" stroke-width="3" />
                <text x={x} y={y - 14} fill="#cbd5e1" font-size="10" text-anchor="middle">{event.time}</text>
              </g>
            );
          })}
        </svg>
      </div>
    </div>

    <!-- Mission Snapshot -->
    <div class="grid lg:grid-cols-4 gap-4 mb-8">
      <div class="bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-xs text-slate-500 mb-1">Priority</div>
        <div class="text-alert-400 font-semibold">{profile.priority}</div>
      </div>
      <div class="bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-xs text-slate-500 mb-1">Agents</div>
        <div class="text-slate-100 font-semibold">{profile.agents.length}</div>
      </div>
      <div class="bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-xs text-slate-500 mb-1">Map Confidence</div>
        <div class="text-rescue-400 font-semibold">{Math.round(profile.simulation.defaultConfidence * 100)}%</div>
      </div>
      <div class="bg-slate-800 rounded-lg p-4 border border-slate-700">
        <div class="text-xs text-slate-500 mb-1">Comms Risk</div>
        <div class="text-alert-400 font-semibold uppercase">{profile.simulation.communicationRisk}</div>
      </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid lg:grid-cols-2 gap-6">
      <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
        <h2 class="text-2xl font-bold mb-4">Terrain & Environment</h2>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between gap-4"><span class="text-slate-400">Type:</span><span class="text-right text-slate-200">{profile.terrain.type}</span></div>
          <div class="flex justify-between gap-4"><span class="text-slate-400">GPS:</span><span class="text-right text-slate-200">{profile.terrain.gps}</span></div>
          <div class="flex justify-between gap-4"><span class="text-slate-400">Communications:</span><span class="text-right text-slate-200">{profile.terrain.communications}</span></div>
          <div class="flex justify-between gap-4"><span class="text-slate-400">Lighting:</span><span class="text-right text-slate-200">{profile.terrain.lighting}</span></div>
        </div>
        <div class="mt-5 pt-4 border-t border-slate-700">
          <h3 class="text-sm font-semibold mb-3 text-slate-300">Hazards</h3>
          <div class="flex flex-wrap gap-2">
            {profile.terrain.hazards.map(hazard => (
              <span class="px-2 py-1 bg-alert-900 text-alert-300 rounded text-xs border border-alert-700">{hazard}</span>
            ))}
          </div>
        </div>
      </div>

      <AgentStatusPanel profile={profile} />
      <TelemetryPanel profile={profile} />
      <SensorOutputsPanel profile={profile} />
      <AiAnalystPanel profile={profile} />
      <MissionReportPanel profile={profile} />
    </div>

    <!-- Mission Events Timeline -->
    <div class="mt-6">
      <TimelinePanel profile={profile} />
    </div>
  </div>
</div>
