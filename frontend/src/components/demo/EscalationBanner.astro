---
// Escalation Banner Component
// Displays mission escalation alerts with severity-based styling

export interface Props {
  escalation?: {
    active: boolean;
    severity: 'none' | 'advisory' | 'warning' | 'urgent' | 'critical';
    reason: string | null;
    area_of_interest: string | null;
    contact_continuity_risk: 'stable' | 'watch' | 'high' | 'critical';
  };
}

const { escalation } = Astro.props;

// Don't render if no escalation or not active
if (!escalation || !escalation.active) {
  return null;
}

// Map severity to visual styling
const getSeverityClasses = (severity: string) => {
  switch (severity) {
    case 'critical':
      return {
        container: 'bg-red-900/40 border-red-500',
        icon: 'text-red-400',
        title: 'text-red-200',
        text: 'text-red-100'
      };
    case 'urgent':
      return {
        container: 'bg-orange-900/40 border-orange-500',
        icon: 'text-orange-400',
        title: 'text-orange-200',
        text: 'text-orange-100'
      };
    case 'warning':
      return {
        container: 'bg-yellow-900/40 border-yellow-500',
        icon: 'text-yellow-400',
        title: 'text-yellow-200',
        text: 'text-yellow-100'
      };
    case 'advisory':
      return {
        container: 'bg-blue-900/40 border-blue-500',
        icon: 'text-blue-400',
        title: 'text-blue-200',
        text: 'text-blue-100'
      };
    default:
      return {
        container: 'bg-slate-800 border-slate-600',
        icon: 'text-slate-400',
        title: 'text-slate-200',
        text: 'text-slate-300'
      };
  }
};

const severityLabel = escalation.severity.toUpperCase();
const classes = getSeverityClasses(escalation.severity);
const shouldPulse = escalation.severity === 'critical' || escalation.severity === 'urgent';
---

<div 
  class={`rounded-lg border-2 p-4 mb-6 ${classes.container} ${shouldPulse ? 'animate-pulse' : ''}`}
  role="alert"
  aria-live="assertive"
>
  <div class="flex items-start gap-3">
    <!-- Alert Icon -->
    <div class={`flex-shrink-0 ${classes.icon}`}>
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          stroke-width="2" 
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        />
      </svg>
    </div>

    <!-- Alert Content -->
    <div class="flex-grow">
      <div class="flex items-center gap-2 mb-2">
        <h3 class={`text-lg font-bold ${classes.title}`}>
          {severityLabel}: Mission Escalation
        </h3>
        {escalation.contact_continuity_risk && escalation.contact_continuity_risk !== 'stable' && (
          <span class={`text-xs px-2 py-1 rounded border ${
            escalation.contact_continuity_risk === 'critical' 
              ? 'bg-red-900/60 border-red-600 text-red-200' 
              : escalation.contact_continuity_risk === 'high'
              ? 'bg-orange-900/60 border-orange-600 text-orange-200'
              : 'bg-yellow-900/60 border-yellow-600 text-yellow-200'
          }`}>
            Contact Risk: {escalation.contact_continuity_risk.toUpperCase()}
          </span>
        )}
      </div>
      
      {escalation.reason && (
        <p class={`text-base ${classes.text} leading-relaxed`}>
          {escalation.reason}
        </p>
      )}

      {escalation.area_of_interest && (
        <div class="mt-2 text-sm opacity-90">
          <span class="font-semibold">Area of Interest:</span> 
          <span class="font-mono ml-1">{escalation.area_of_interest}</span>
        </div>
      )}
    </div>
  </div>
</div>
