      "agent_id": "drone-a",
      "sector_id": "main-chamber",
      "requires_user_action": false,
      "event_data": {
        "scan_progress": "40%"
      }
    },
    {
      "trigger_at_seconds": 240,
      "event_type": "detection",
      "title": "Ceramic Artifacts Detected",
      "description": "Multiple ceramic vessels identified in northern alcove. Intact condition.",
      "severity": "success",
      "agent_id": "drone-a",
      "sector_id": "artifact-alcove-north",
      "requires_user_action": false,
      "event_data": {
        "artifact_count": 7,
        "artifact_type": "ceramic_vessels",
        "condition": "intact"
      }
    },
    {
      "trigger_at_seconds": 300,
      "event_type": "milestone",
      "title": "Main Chamber Scan Complete",
      "description": "3D photogrammetry scan complete. High-resolution model generated.",
      "severity": "success",
      "agent_id": "drone-a",
      "sector_id": "main-chamber",
      "requires_user_action": false,
      "event_data": {
        "scan_resolution": "0.5mm",
        "model_quality": "high"
      }
    },
    {
      "trigger_at_seconds": 360,
      "event_type": "detection",
      "title": "Pigment Analysis - UV Fluorescence",
      "description": "UV imaging reveals previously invisible pigments on wall art. Preservation excellent.",
      "severity": "success",
      "agent_id": "micro-scanner",
      "sector_id": "main-chamber",
      "requires_user_action": false,
      "event_data": {
        "analysis_type": "uv_fluorescence",
        "hidden_details": true
      }
    },
    {
      "trigger_at_seconds": 420,
      "event_type": "detection",
      "title": "Metal Artifacts Detected",
      "description": "Metal objects detected in southern alcove. Possible ritual items.",
      "severity": "success",
      "agent_id": "micro-scanner",
      "sector_id": "artifact-alcove-south",
      "requires_user_action": false,
      "event_data": {
        "artifact_type": "metal_objects",
        "suspected_use": "ritual"
      }
    },
    {
      "trigger_at_seconds": 480,
      "event_type": "detection",
      "title": "Structural Concern - Partial Collapse",
      "description": "Partial collapse detected in side passage. Avoid direct entry. Document remotely only.",
      "severity": "warning",
      "agent_id": "drone-a",
      "sector_id": "collapse-zone",
      "requires_user_action": true,
      "event_data": {
        "hazard_type": "partial_collapse",
        "recommendation": "remote_documentation_only"
      }
    },
    {
      "trigger_at_seconds": 540,
      "event_type": "milestone",
      "title": "Artifact Documentation Complete",
      "description": "All accessible artifacts documented. Burial chamber remains to be explored.",
      "severity": "info",
      "agent_id": "micro-scanner",
      "sector_id": "artifact-alcove-south",
      "requires_user_action": false,
      "event_data": {
        "total_artifacts_documented": 23
      }
    }
  ]
