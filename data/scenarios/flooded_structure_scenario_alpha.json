{
  "scenario_id": "flooded-structure-alpha-01",
  "name": "Flooded Structure Alpha - Cargo Vessel Inspection",
  "description": "Amphibious inspection of partially flooded cargo vessel. Models water navigation, buoyancy challenges, corrosion risks, and air pocket detection.",
  "use_case": "flooded-structure-inspection",
  "digital_twin_site_slug": "liberty-cargo-vessel-demo",
  "digital_twin_terrain_slug": "main-deck-holds",
  "origin_sector_id": "hull-breach",
  "duration_seconds": 600,
  "agent_routes": [
    {
      "agent_id": "surface-station",
      "agent_name": "Surface Command Station",
      "agent_role": "relay",
      "deploy_at_seconds": 0,
      "average_speed_m_per_s": 0,
      "battery_drain_rate_percent_per_second": 0,
      "sensors": ["Radio", "GPS", "Weather Monitor"],
      "behavior": "stationary_relay",
      "waypoints": [
        {
          "sequence_order": 1,
          "sector_id": "hull-breach",
          "action": "establish_surface_relay",
          "pause_duration_seconds": 600,
          "notes": "Surface station at hull breach"
        }
      ]
    },
    {
      "agent_id": "rov-a",
      "agent_name": "Primary ROV",
      "agent_role": "mapper",
      "deploy_at_seconds": 30,
      "average_speed_m_per_s": 0.8,
      "battery_drain_rate_percent_per_second": 0.04,
      "sensors": ["Sonar", "Pressure", "Underwater Camera", "Hydrophone", "Water Quality", "Underwater Spotlight", "Thermal Camera"],
      "behavior": "amphibious_exploration",
      "waypoints": [
        {
          "sequence_order": 1,
          "sector_id": "hull-breach",
          "action": "initial_survey",
          "pause_duration_seconds": 20,
          "notes": "Survey breach and water conditions"
        },
        {
          "sequence_order": 2,
          "sector_id": "passage-main-01",
          "action": "map_corridor",
          "pause_duration_seconds": 30,
          "notes": "Map main corridor, check for obstructions"
        },
        {
          "sequence_order": 3,
          "sector_id": "cargo-hold-2",
          "action": "inspect_hold",
          "pause_duration_seconds": 45,
          "notes": "Inspect partially flooded cargo hold"
        },
        {
          "sequence_order": 4,
          "sector_id": "engine-room",
          "action": "deep_inspection",
          "pause_duration_seconds": 60,
          "notes": "Deep dive to engine room"
        }
      ]
    },
    {
      "agent_id": "rov-b",
      "agent_name": "Micro ROV",
      "agent_role": "detector",
      "deploy_at_seconds": 90,
      "average_speed_m_per_s": 0.5,
      "battery_drain_rate_percent_per_second": 0.05,
      "sensors": ["Mini Camera", "Temperature", "Gas Detector", "Hydrophone", "Speaker", "Microphone"],
      "behavior": "air_pocket_search",
      "waypoints": [
        {
          "sequence_order": 1,
          "sector_id": "hull-breach",
          "action": "launch",
          "pause_duration_seconds": 10,
          "notes": "Deploy micro ROV"
        },
        {
          "sequence_order": 2,
          "sector_id": "passage-main-01",
          "action": "explore",
          "pause_duration_seconds": 20,
          "notes": "Search for air pockets"
        },
        {
          "sequence_order": 3,
          "sector_id": "crew-quarters-b",
          "action": "investigate_air_pocket",
          "pause_duration_seconds": 90,
          "notes": "Investigate detected air pocket"
        }
      ]
    },
    {
      "agent_id": "surface-relay",
      "agent_name": "Surface Buoy Relay",
      "agent_role": "relay",
      "deploy_at_seconds": 180,
      "average_speed_m_per_s": 0.3,
      "battery_drain_rate_percent_per_second": 0.015,
      "sensors": ["Radio Repeater", "GPS"],
      "behavior": "floating_relay",
      "waypoints": [
        {
          "sequence_order": 1,
          "sector_id": "hull-breach",
          "action": "launch",
          "pause_duration_seconds": 5,
          "notes": "Deploy from surface"
        },
        {
          "sequence_order": 2,
          "sector_id": "cargo-hold-2",
          "override_x_m": 22.0,
          "override_y_m": 0.0,
          "override_z_m": 0.5,
          "action": "establish_relay",
          "pause_duration_seconds": 600,
          "notes": "Float at waterline above hold"
        }
      ]
    }
