{
  "scenario_id": "collapsed-building-alpha-01",
  "name": "Collapsed Building Alpha - Standard Search",
  "use_case": "collapsed-building-search",
  "digital_twin_site_slug": "urban-collapse-alpha-demo",
  "digital_twin_terrain_slug": "alpha-building-structure",
  "estimated_duration_seconds": 600,
  "origin_sector_id": "ground-entry",
  "allow_agent_deployment": true,
  "allow_agent_redirect": true,
  "allow_agent_recall": true,
  "description": "Standard collapsed building search scenario with 3 drones exploring a multi-floor structure. Includes thermal/audio detections and progressive battery degradation.",
  "metadata": {
    "difficulty": "medium",
    "environment": "urban",
    "hazards": ["structural_instability", "dust", "limited_visibility"]
  },
  
  "agent_routes": [
    {
      "agent_id": "relay-1",
      "agent_name": "Static Relay Node",
      "agent_role": "relay",
      "deploy_at_seconds": 0,
      "sensors": [],
      "average_speed_m_per_s": 0,
      "battery_drain_rate_percent_per_second": 0,
      "behavior": "static",
      "metadata": {"powered": true},
      "waypoints": [
        {
          "sequence_order": 0,
          "sector_id": "ground-entry",
          "action": "deploy-relay",
          "pause_duration_seconds": 0
        }
      ]
    },
    {
      "agent_id": "drone-a",
      "agent_name": "Scout Drone A",
      "agent_role": "mapper",
      "deploy_at_seconds": 30,
      "sensors": ["LiDAR", "Thermal Camera", "Low-Light RGB Camera", "IR Camera", "Visible Spotlight"],
      "average_speed_m_per_s": 2.0,
      "battery_drain_rate_percent_per_second": 0.05,
      "behavior": "patrol",
      "waypoints": [
        {
          "sequence_order": 0,
          "sector_id": "ground-entry",
          "action": "checkpoint",
          "pause_duration_seconds": 0
        },
        {
          "sequence_order": 1,
          "sector_id": "ground-lobby",
          "action": "explore",
          "pause_duration_seconds": 15
        },
        {
          "sequence_order": 2,
          "sector_id": "ground-corridor-east",
          "action": "explore",
          "pause_duration_seconds": 20
        },
        {
          "sequence_order": 3,
          "sector_id": "floor-1-corridor",
          "action": "explore",
          "pause_duration_seconds": 25
        },
        {
          "sequence_order": 4,
          "sector_id": "floor-2-corridor-west",
          "action": "explore",
          "pause_duration_seconds": 30
        }
      ]
    },
    {
      "agent_id": "drone-b",
      "agent_name": "Thermal/Audio Drone",
      "agent_role": "detector",
      "deploy_at_seconds": 60,
      "sensors": ["Thermal Camera", "Microphone Array", "Speaker", "WiFi Scanner", "CO2 Sensor"],
      "average_speed_m_per_s": 1.5,
      "battery_drain_rate_percent_per_second": 0.067,
      "behavior": "one-way",
      "metadata": {"mission": "basement_search"},
      "waypoints": [
        {
          "sequence_order": 0,
          "sector_id": "ground-entry",
          "action": "checkpoint",
          "pause_duration_seconds": 0
        },
        {
          "sequence_order": 1,
          "sector_id": "ground-lobby",
          "action": "scan",
          "pause_duration_seconds": 30
        },
        {
          "sequence_order": 2,
          "sector_id": "basement-corridor",
          "action": "deploy-relay",
          "pause_duration_seconds": 0,
          "metadata": {"reason": "battery_low_relay_needed"}
        }
      ]
    },
    {
      "agent_id": "drone-c",
      "agent_name": "Relay Drone",
      "agent_role": "relay",
      "deploy_at_seconds": 90,
      "sensors": [],
      "average_speed_m_per_s": 1.0,
      "battery_drain_rate_percent_per_second": 0.056,
      "behavior": "static",
      "waypoints": [
        {
          "sequence_order": 0,
          "sector_id": "ground-entry",
          "action": "checkpoint",
          "pause_duration_seconds": 0
        },
        {
          "sequence_order": 1,
          "sector_id": "ground-corridor-east",
          "action": "deploy-relay",
          "pause_duration_seconds": 0,
          "override_z_m": 2.0,
          "metadata": {"relay_position": "elevated"}
        }
      ]
    }
  ],
  
  "events": [
    {
      "trigger_at_seconds": 30,
      "event_type": "sector-explored",
      "agent_id": "drone-a",
      "sector_id": "ground-lobby",
      "title": "Ground Floor Lobby Explored",
      "description": "Scout Drone A has mapped the ground floor lobby area",
      "severity": "info",
      "event_data": {
        "confidence": 0.85,
        "hazards_detected": false
      }
    },
    {
      "trigger_at_seconds": 90,
      "event_type": "sector-explored",
      "agent_id": "drone-a",
      "sector_id": "ground-corridor-east",
      "title": "East Corridor Mapped",
      "description": "Scout Drone A has completed mapping the east corridor",
      "severity": "info",
      "event_data": {
        "confidence": 0.78
      }
    },
    {
      "trigger_at_seconds": 180,
      "event_type": "sector-explored",
      "agent_id": "drone-a",
      "sector_id": "floor-1-corridor",
      "title": "First Floor Explored",
      "description": "Scout Drone A has reached and mapped the first floor corridor",
      "severity": "info",
      "event_data": {
        "confidence": 0.72,
        "elevation_m": 3.5
      }
    },
    {
      "trigger_at_seconds": 240,
      "event_type": "detection-audio",
      "agent_id": "drone-b",
      "sector_id": "basement-corridor",
      "title": "Voice-like Audio Detected",
      "description": "Thermal/Audio Drone detected voice-like sounds in basement corridor",
      "severity": "warning",
      "event_data": {
        "detection_type": "voice",
        "confidence": 0.58,
        "frequency_range": "human_vocal",
        "depth_m": 3.5
      },
      "requires_user_action": true,
      "user_action_type": "acknowledge"
    },
    {
      "trigger_at_seconds": 300,
      "event_type": "sector-explored",
      "agent_id": "drone-a",
      "sector_id": "floor-2-corridor-west",
      "title": "Second Floor West Corridor Mapped",
      "description": "Scout Drone A has reached the second floor",
      "severity": "info",
      "event_data": {
        "confidence": 0.68,
        "elevation_m": 7.0
      }
    },
    {
      "trigger_at_seconds": 320,
      "event_type": "detection-thermal",
      "agent_id": "drone-b",
      "sector_id": "basement-corridor",
      "title": "Thermal Anomaly Detected",
      "description": "Possible heat signature detected in basement corridor",
      "severity": "warning",
      "event_data": {
        "temperature_delta": 2.3,
        "confidence": 0.45,
        "depth_m": 3.5
      }
    },
    {
      "trigger_at_seconds": 360,
      "event_type": "agent-landed-relay",
      "agent_id": "drone-b",
      "sector_id": "basement-corridor",
      "title": "Drone B Landed as Relay",
      "description": "Thermal/Audio Drone has landed in basement corridor to serve as communications relay",
      "severity": "warning",
      "event_data": {
        "reason": "battery_below_return_threshold",
        "remaining_battery": 15,
        "relay_value": "high"
      }
    },
    {
      "trigger_at_seconds": 420,
      "event_type": "failure-battery",
      "agent_id": "drone-a",
      "sector_id": "floor-2-corridor-west",
      "title": "Scout Drone A Battery Degraded",
      "description": "Scout Drone A showing accelerated battery drain, likely dust interference",
      "severity": "warning",
      "event_data": {
        "battery_percent": 35,
        "expected_battery": 55,
        "drain_rate_increase": 1.6
      },
      "requires_user_action": true,
      "user_action_type": "redirect-agent",
      "metadata": {
        "suggested_actions": ["return_to_base", "continue_priority_scan", "land_relay"]
      }
    },
    {
      "trigger_at_seconds": 480,
      "event_type": "agent-sacrificed",
      "agent_id": "drone-c",
      "sector_id": "ground-corridor-east",
      "title": "Relay Drone Sacrificed",
      "description": "Relay Drone battery depleted, now serving as passive relay marker",
      "severity": "critical",
      "event_data": {
        "battery_percent": 0,
        "nfc_recovery_available": true,
        "black_box_available": true
      }
    },
    {
      "trigger_at_seconds": 540,
      "event_type": "escalation",
      "title": "Mission Escalation: Return Threshold",
      "description": "Multiple agents below safe return threshold. Recommend mission conclusion.",
      "severity": "critical",
      "event_data": {
        "agents_below_threshold": 2,
        "mesh_health": 68,
        "detections_pending_review": 2
      },
      "requires_user_action": true,
      "user_action_type": "custom",
      "metadata": {
        "options": ["continue_mission", "recall_all_agents", "deploy_fresh_agent"]
      }
    },
    {
      "trigger_at_seconds": 35,
      "event_type": "lighting_mode_change",
      "title": "Lighting Mode: Visible Spotlight",
      "description": "Scout drone activating spotlight for initial lobby scan.",
      "severity": "info",
      "agent_id": "drone-a",
      "sector_id": "ground-lobby",
      "requires_user_action": false,
      "event_data": {
        "previous_mode": "low_light_rgb",
        "new_mode": "visible_spotlight",
        "light_active": true,
        "light_intensity_percent": 70,
        "battery_impact": 0.07,
        "image_confidence": 0.65,
        "confidence_penalty_factors": {
          "dust": 0.35
        },
        "reason": "heavy_dust_obscuration"
      }
    },
    {
      "trigger_at_seconds": 100,
      "event_type": "seismic_sensor_deployed",
      "title": "Seismic Sensor 1 Deployed - Ground Level",
      "description": "Ground acoustic sensor deployed at ground entry for survivor detection.",
      "severity": "info",
      "agent_id": "relay-1",
      "sector_id": "ground-entry",
      "requires_user_action": false,
      "event_data": {
        "sensor_id": "seismic-node-1",
        "background_noise_level": 0.42,
        "detection_threshold": 0.55
      }
    },
    {
      "trigger_at_seconds": 140,
      "event_type": "seismic_sensor_deployed",
      "title": "Seismic Sensor 2 Deployed - Basement Access",
      "description": "Second acoustic sensor deployed near basement to improve triangulation.",
      "severity": "info",
      "agent_id": "drone-c",
      "sector_id": "ground-corridor-east",
      "requires_user_action": false,
      "event_data": {
        "sensor_id": "seismic-node-2",
        "background_noise_level": 0.38,
        "detection_threshold": 0.52
      }
    },
    {
      "trigger_at_seconds": 185,
      "event_type": "lighting_mode_change",
      "title": "Lighting Mode: Thermal",
      "description": "Scout drone switching to thermal camera for heat signature scan.",
      "severity": "info",
      "agent_id": "drone-a",
      "sector_id": "floor-1-corridor",
      "requires_user_action": false,
      "event_data": {
        "previous_mode": "visible_spotlight",
        "new_mode": "thermal",
        "light_active": false,
        "light_intensity_percent": 0,
        "battery_impact": 0.02,
        "image_confidence": 0.88,
        "confidence_penalty_factors": {},
        "reason": "survivor_search_thermal_scan"
      }
    },
    {
      "trigger_at_seconds": 220,
      "event_type": "seismic_detection",
      "title": "Seismic: Structural Settling Detected",
      "description": "Seismic sensors detecting structural movement, not human-generated.",
      "severity": "warning",
      "agent_id": "drone-a",
      "sector_id": "floor-1-corridor",
      "requires_user_action": false,
      "event_data": {
        "sensor_id": "seismic-node-1",
        "type": "structural_movement",
        "confidence": 0.82,
        "pattern": "irregular low-frequency vibration",
        "frequency_hz": 1.8,
        "human_cue_probability": 0.12,
        "classification": "structural_noise",
        "requires_human_review": false
      }
    },
    {
      "trigger_at_seconds": 265,
      "event_type": "seismic_detection",
      "title": "Seismic: Possible Human Tapping",
      "description": "Seismic node 2 detected rhythmic tapping pattern, possibly human-generated.",
      "severity": "critical",
      "agent_id": "drone-b",
      "sector_id": "basement-corridor",
      "requires_user_action": true,
      "event_data": {
        "sensor_id": "seismic-node-2",
        "type": "tapping",
        "confidence": 0.79,
        "pattern": "3 distinct impacts, 2.1s intervals",
        "frequency_hz": 3.8,
        "human_cue_probability": 0.84,
        "classification": "possible_human_tapping",
        "requires_human_review": true
      }
    },
    {
      "trigger_at_seconds": 290,
      "event_type": "talkback_message_sent",
      "title": "Talkback: Message to Basement",
      "description": "Operator message sent through Thermal/Audio Drone speaker to basement location.",
      "severity": "info",
      "agent_id": "drone-b",
      "sector_id": "basement-corridor",
      "requires_user_action": false,
      "event_data": {
        "message": "If you can hear me, tap three times.",
        "audio_link_quality": 0.72,
        "delivery_status": "delivered",
        "response_expected": true,
        "response_window_seconds": 30
      }
    },
    {
      "trigger_at_seconds": 310,
      "event_type": "talkback_response_detected",
      "title": "Talkback Response: Three Taps Confirmed",
      "description": "Seismic sensor confirmed three distinct taps following talkback message. Strong survivor indication.",
      "severity": "critical",
      "agent_id": "drone-b",
      "sector_id": "basement-storage",
      "requires_user_action": true,
      "event_data": {
        "original_message_at": 290,
        "response_type": "tapping",
        "tap_count": 3,
        "confidence": 0.91,
        "requires_human_review": true,
        "transcript": "[Tapping detected: 3 distinct impacts, 1.0-1.3s intervals, high confidence human response]"
      }
    }
  ]
